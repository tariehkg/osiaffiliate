---
import { method } from './data';
---

<section class="trust" id="method">
  <div class="wrap">
    <div class="trust-panel" data-rise>
      <header class="trust-head">
        <h2>How a pick gets on this page</h2>
        <p>
          Nobody has rated these tools for us. There is no star average, no review count and
          no customer quote on this site, because we do not have real ones. Here is what we
          do have.
        </p>
      </header>

      <div class="trust-lattice">
        {
          method.map((m) => (
            <div class="trust-cell">
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </div>
          ))
        }
      </div>

      <p class="trust-foot">
        Some links here pay us a commission if you sign up. Read the <a
          href="/disclosure"
          class="tlink">full disclosure</a
        > or the longer <a href="/how-we-pick" class="tlink">methodology</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(1rem, 2vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .trust-panel {
    background: var(--color-brand-surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(1.5rem, 4vw, 3.25rem);
  }

  .trust-head h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.35rem);
    font-weight: 650;
    max-width: 24ch;
  }

  .trust-head p {
    margin-top: 0.9rem;
    max-width: 58ch;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .trust-lattice {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }

  .trust-cell {
    background: var(--color-brand-surface);
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }

  .trust-cell h3 {
    font-size: 1.06rem;
    font-weight: 600;
    max-width: 30ch;
  }

  .trust-cell p {
    margin-top: 0.55rem;
    font-size: 0.915rem;
    line-height: 1.55;
    max-width: 46ch;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .trust-foot {
    margin-top: clamp(1.25rem, 2.5vw, 1.9rem);
    font-size: 0.925rem;
    font-weight: 500;
    max-width: 60ch;
  }

  .trust-foot a {
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 55%, transparent);
  }

  @media (min-width: 54rem) {
    .trust-lattice {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
