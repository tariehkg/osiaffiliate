---
import Mark from './Mark.astro';
---

<section class="stance">
  <div class="wrap stance-inner">
    <blockquote class="stance-quote" data-rise>
      <p>
        Every directory you have ever used makes money the same way we do. The difference is
        that we tell you <em>which links pay us</em>, and the tool we would actually choose
        still comes first.
      </p>
      <footer class="stance-by">
        <Mark size={22} tone="light" />
        <span>The OSI Affiliate team</span>
      </footer>
    </blockquote>

    <a href="/how-we-pick" class="pill pill-invert stance-go" data-rise>Read the methodology</a>
  </div>
</section>

<style>
  /* The page's one inverted block. It carries itself on type alone — the
     concentric rings that used to sit behind it were decoration with nothing
     to say, and the navy is stronger without them. */
  .stance {
    background: var(--color-brand-secondary);
    color: white;
    padding-block: clamp(3.75rem, 9vw, 7rem);
  }

  .stance-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1.75rem, 3.5vw, 2.6rem);
  }

  .stance-quote {
    margin: 0;
    max-width: 47rem;
  }

  .stance-quote p {
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 4.4vw, 2.85rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  /* Emphasis by rule, not by recolouring the words. Underlines are already
     this site's emphasis vocabulary (see `.tlink`), and a colour swap on a
     single phrase is the oldest tell in the book. */
  .stance-quote em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: var(--color-brand-accent);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.16em;
  }

  .stance-by {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: clamp(1.4rem, 3vw, 2.1rem);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.66);
  }

  .stance-go {
    flex: none;
  }
</style>
