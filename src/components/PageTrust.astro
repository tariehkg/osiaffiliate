---
/**
 * Closing panel for hub and comparison pages.
 *
 * Says what the page is and is not — researched rather than hands-on tested,
 * priced from the vendor's own pricing page on the day we read it — and hands
 * the reader the two pages that back that claim up. Same surface panel as the
 * homepage trust block, so the site keeps one gesture for "here is the
 * caveat".
 */
interface Props {
  /** Heading — page-specific, because the caveat differs slightly. */
  title?: string;
  /** Overrides the default body copy. */
  body?: string;
}

const {
  title = 'What this page is, and what it is not',
  body = 'This is desk research, not a lab report. Plan lines come from each vendor’s own current pricing and documentation, read on the day this page was written, and the reasoning is our editorial judgement rather than a score assembled from other people’s reviews. We have not run every one of these tools in a live business, and where that matters we say so in the entry rather than implying otherwise. Vendors change pricing and packaging often, so check the number on their page before you commit to it.',
} = Astro.props;
---

<section class="pt">
  <div class="wrap">
    <div class="pt-panel">
      <h2>{title}</h2>
      <p>{body}</p>

      <ul class="pt-links">
        <li><a href="/how-we-pick" class="tlink">How we pick</a></li>
        <li><a href="/disclosure" class="tlink">Affiliate disclosure</a></li>
        <li><a href="/contact" class="tlink">Send a correction</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .pt {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .pt-panel {
    background: var(--color-brand-surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(1.4rem, 3.5vw, 2.5rem);
  }

  .pt-panel h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 600;
    max-width: 26ch;
  }

  .pt-panel p {
    margin-top: 0.85rem;
    max-width: 72ch;
    font-size: 0.945rem;
    line-height: 1.65;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .pt-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin: clamp(1.1rem, 2.5vw, 1.6rem) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.93rem;
    font-weight: 500;
  }

  .pt-links a {
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 55%, transparent);
  }
</style>
