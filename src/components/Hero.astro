---
import Mark from './Mark.astro';
import SearchBox from './SearchBox.astro';
import { ofType, type Article } from './articles';

/**
 * The homepage opening. Painted by CSS alone: no reveal, no script, because
 * it is above the fold on every viewport.
 *
 * The phrase stays. What changed underneath it is the promise: reviews by
 * staff who signed up for the tools, not ratings collected from readers.
 * The three counts are read from the articles collection, so they cannot
 * drift from what is actually published.
 */
interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const stats = [
  { n: ofType(articles, 'review').length, label: 'staff reviews' },
  { n: ofType(articles, 'best').length, label: 'shortlists' },
  { n: ofType(articles, 'comparison').length + ofType(articles, 'alternatives').length, label: 'comparisons' },
];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-frame">
      <div class="hero-ghost"><Mark size={900} /></div>
    </div>
  </div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="hero-h" data-enter style="--enter-i:0">Where you find<br />the right software.</h1>
      <p class="hero-sub" data-enter style="--enter-i:1">
        Independent reviews of business software for solopreneurs and small teams. Our staff sign up,
        test each tool against the same criteria, and write down what they found, including the reasons
        to skip it.
      </p>

      <div class="hero-search" data-enter style="--enter-i:2">
        <SearchBox variant="hero" id="search-hero" placeholder="Search HubSpot, CRM, email marketing…" />
      </div>

      <ul class="hero-stats" aria-label="What is on the site" data-enter style="--enter-i:3">
        {stats.map((s) => (
          <li>
            <b>{s.n}</b>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-aside" data-enter style="--enter-i:2">
      <div class="hero-mark"><Mark size={160} /></div>
      <p class="hero-note">
        Some links here pay us a commission. We say which ones, and a commission has never moved a
        score.
        <a href="/disclosure" class="tlink">The disclosure</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.25rem, 4.5vw, 3.5rem);
    background:
      radial-gradient(
        46% 40% at 96% 2%,
        color-mix(in oklab, var(--color-brand-primary) 10%, transparent),
        transparent 74%
      ),
      linear-gradient(180deg, var(--surface-alt) 0%, var(--color-brand-bg) 48%);
    border-bottom: 1px solid var(--line);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-frame {
    position: relative;
    height: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
  }

  .hero-ghost {
    position: absolute;
    right: -11rem;
    top: -11rem;
    opacity: 0.1;
    mask-image: radial-gradient(
      44% 62% at 100% 4%,
      black 0%,
      color-mix(in oklab, black 55%, transparent) 42%,
      transparent 82%
    );
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-h {
    font-size: clamp(2.5rem, 6.2vw, 5.25rem);
    font-weight: var(--fw-bold);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 22ch;
  }

  .hero-sub {
    margin-top: clamp(1rem, 2.2vw, 1.4rem);
    max-width: 52ch;
    font-size: var(--fs-lede);
    line-height: 1.55;
    font-weight: var(--fw-light);
    color: color-mix(in oklab, var(--color-brand-text) 78%, transparent);
  }

  .hero-search {
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero-note {
    max-width: 30ch;
    padding: 0.15rem 0 0.2rem 0.9rem;
    border-left: 3px solid var(--color-brand-accent);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-brand-text) 76%, transparent);
  }

  .hero-note a {
    margin-left: 0.2rem;
    font-weight: var(--fw-medium);
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 55%, transparent);
  }

  .hero-mark {
    display: none;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    padding: 0;
    list-style: none;
    max-width: 30rem;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .hero-stats li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.45rem;
    background: var(--color-brand-bg);
    padding: 0.55rem 0.9rem;
  }

  .hero-stats b {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-primary);
  }

  .hero-stats span {
    font-size: var(--fs-caption);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  @media (min-width: 72rem) {
    .hero-ghost {
      right: calc(var(--gutter) - 36rem);
      top: auto;
      bottom: -27rem;
      opacity: 0.22;
      mask-image: radial-gradient(
        21% 21% at 13% 13%,
        black 0%,
        color-mix(in oklab, black 44%, transparent) 46%,
        transparent 88%
      );
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
      align-items: end;
    }

    .hero-mark {
      display: block;
    }

    .hero-aside {
      justify-self: end;
      align-items: start;
      gap: 2.2rem;
      transform: translate(-0.5rem, -1rem);
    }
  }

  @media (max-width: 34rem) {
    .hero-note {
      max-width: 40ch;
    }
  }
</style>
