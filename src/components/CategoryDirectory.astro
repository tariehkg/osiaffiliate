---
import { directoryGroups } from './directory-taxonomy';

/**
 * The category wall — the site's whole intended scope, in one object.
 *
 * Breadth, not depth: the browser higher up the page shows real picks inside
 * five categories, and this shows every category the site is being built to
 * cover. Nine groups, the standard industry names in each.
 *
 * Every entry that has a real hub page renders as a real <a>; every entry
 * that doesn't renders as plain muted text in a <span> — no marker, no
 * underline, no hover. That's a normal, necessary UI distinction (a visitor
 * shouldn't be able to click something that goes nowhere), not explanatory
 * copy — the heading and intro deliberately don't narrate which categories
 * are live vs. still being written, they just present the whole landscape.
 *
 * Layout: nine groups on an exact 3×3 at desktop, so the wall closes as a
 * rectangle instead of wrapping to a short last row with a hole in it.
 * Hairlines are drawn as cell borders rather than as a gap over a coloured
 * backdrop.
 *
 * Each group's cell is capped by a rule that is cobalt when that group has a
 * live shortlist in it and a hairline otherwise, with the group's own name
 * following the same two states — a subtle, purely visual cue, not a stated
 * count.
 */

const groups = directoryGroups.map((g) => ({
  ...g,
  live: g.entries.filter((e) => e.href).length,
}));
---

<section class="dir" id="directory">
  <div class="wrap">
    <header class="dir-head" data-rise>
      <div class="dir-head-copy">
        <h2>Browse by category.</h2>
        <p>
          Organized the way you'd actually go looking for software — not an alphabetical
          wall, and never sorted by who paid to be listed.
        </p>
      </div>
    </header>

    <div class="dir-wall" data-rise>
      {
        groups.map((g) => (
          <section class:list={['dir-grp', { 'has-live': g.live > 0 }]}>
            <h3 class="dir-grp-name">{g.group}</h3>

            <ul class="dir-items">
              {g.entries.map((e) => (
                <li class:list={['dir-item', { 'is-live': Boolean(e.href) }]}>
                  {e.href ? <a href={e.href}>{e.name}</a> : <span>{e.name}</span>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .dir-head {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* Set heavier and larger than any other heading on the page on purpose:
     this one is making a specific numeric claim about the whole site, and it
     is the only place the claim is made. */
  .dir-head h2 {
    font-size: clamp(2.4rem, 4vw, 3.75rem);
    font-weight: var(--fw-black);
    letter-spacing: -0.042em;
    line-height: 0.98;
    max-width: 16ch;
  }

  .dir-head p {
    margin-top: 1.15rem;
    max-width: 58ch;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .dir-wall {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    /* Implicit rows come in pairs — group name, then list — so every group in
       a row starts its list on the same line however many lines its own name
       runs to. Both tracks are auto: an earlier `1fr` on the list track made
       every row as tall as the tallest list on the whole wall, which left the
       bottom row two thirds empty. */
    grid-auto-rows: auto;

    /* The outer edges the cells cannot draw themselves. Each cell carries its
       own left and bottom hairline and its own top rule, so these two close
       the rectangle. */
    border-right: 1px solid var(--line);
  }

  .dir-grp {
    position: relative;
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    padding: 1.4rem 1.25rem 1.55rem;
  }

  /* A group with a real shortlist in it gets the cobalt cap; one that is all
     still planned keeps the hairline. Top row is all cobalt, bottom row all
     hairline, because that is where the site actually is.
     Drawn over the hairline rather than replacing it, so a 3px rule and a 1px
     rule do not push their cells' contents onto two different baselines. */
  .dir-grp.has-live {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-primary) 5%, transparent),
      transparent 42%
    );
  }

  .dir-grp.has-live::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 3px;
    background: var(--color-brand-primary);
  }

  .dir-grp-name {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    line-height: 1.22;
    letter-spacing: -0.024em;
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
    text-wrap: pretty;
  }

  .dir-grp.has-live .dir-grp-name {
    color: var(--color-brand-primary);
  }

  .dir-items {
    margin: 1.05rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  /* The marker column is reserved on every row so live and planned names sit
     on one left edge — only the live rows put anything in it. */
  .dir-item {
    position: relative;
    padding-left: 0.95rem;
  }

  .dir-item.is-live::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    background: var(--color-brand-primary);
  }

  .dir-item span {
    color: color-mix(in oklab, var(--color-brand-text) 46%, transparent);
  }

  .dir-item a {
    color: color-mix(in oklab, var(--color-brand-text) 88%, transparent);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 50%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .dir-item a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  /* Two columns leaves nine groups one short of a full last row, so the ninth
     takes the whole width and the wall still closes as a rectangle. */
  @media (min-width: 45rem) and (max-width: 63.9375rem) {
    .dir-wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dir-grp:last-child {
      grid-column: 1 / -1;
    }

    .dir-grp:last-child .dir-items {
      flex-flow: row wrap;
      gap: 0.6rem 2.5rem;
    }
  }

  /* Nine groups, three columns: an exact 3×3 with no half-empty last row. */
  @media (min-width: 64rem) {
    .dir-wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .dir-grp {
      padding-block: 1.15rem 1.3rem;
    }
  }
</style>
