---
import Mark from './Mark.astro';
import { categories } from './data';
import { articleUrl, ofType, type Article } from './articles';

/**
 * The footer is the site map: every category, every review, every list,
 * every comparison and every guide, read from the collection so it is never
 * out of date. The disclosure sits above the copyright at body size, marked
 * with the amber lead segment, because it is the site's headline promise
 * and not fine print.
 */
interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const reviews = ofType(articles, 'review').sort((a, b) => (a.data.product?.name ?? '').localeCompare(b.data.product?.name ?? ''));
const best = ofType(articles, 'best');
const alternatives = ofType(articles, 'alternatives');
const comparisons = ofType(articles, 'comparison');
const pricing = ofType(articles, 'pricing');
const guides = ofType(articles, 'guide');
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <Mark size={28} tone="light" wordmark />
        <p>
          Independent reviews, shortlists and comparisons of business software for solopreneurs
          and small teams, written and scored by our staff, with the business model stated on the
          page instead of buried in it.
        </p>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        <div class="foot-col">
          <h2>Categories</h2>
          <ul>
            {categories.map((c) => <li><a href={c.hub} class="foot-cat" data-tone={c.tone}><i aria-hidden="true"></i>{c.name}</a></li>)}
          </ul>
          <h2 class="foot-col-h2">Best of</h2>
          <ul>
            {best.map((a) => <li><a href={articleUrl(a)}>Best {categories.find((c) => c.id === a.data.category)?.plain} tools</a></li>)}
          </ul>
        </div>

        <div class="foot-col foot-col-wide">
          <h2>Reviews</h2>
          <ul class="foot-two">
            {reviews.map((a) => <li><a href={articleUrl(a)}>{a.data.product?.name}</a></li>)}
          </ul>
        </div>

        <div class="foot-col">
          <h2>Compare</h2>
          <ul>
            {comparisons.map((a) => <li><a href={articleUrl(a)}>{a.data.title.split(':')[0]}</a></li>)}
            {alternatives.map((a) => <li><a href={articleUrl(a)}>{a.data.title.split(' best ')[1]?.split(' in ')[0]}</a></li>)}
          </ul>
          <h2 class="foot-col-h2">Pricing guides</h2>
          <ul>
            {pricing.map((a) => <li><a href={articleUrl(a)}>{a.data.product?.name} pricing</a></li>)}
          </ul>
        </div>

        <div class="foot-col">
          <h2>Guides</h2>
          <ul>
            {guides.map((a) => <li><a href={articleUrl(a)}>{a.data.title}</a></li>)}
            <li><a href="/articles">All articles</a></li>
          </ul>
          <h2 class="foot-col-h2">OSI Affiliate</h2>
          <ul>
            <li><a href="/about">About and team</a></li>
            <li><a href="/how-we-pick">How we test and score</a></li>
            <li><a href="/disclosure">Affiliate disclosure</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="foot-bottom">
      <p class="foot-disclose">
        Some links on this site are affiliate links: if you sign up through one, the vendor pays us
        a commission at no extra cost to you. No vendor pays for placement, for a higher position or
        for a higher score. <a href="/disclosure">Read the full disclosure</a>.
      </p>
      <div class="foot-sign">
        <p class="foot-sign-line">New reviews go up when they are finished, not when they are due.</p>
        <p class="foot-copy">&copy; {year} OSI Affiliate</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--color-brand-secondary);
    color: color-mix(in oklab, white 78%, transparent);
    padding-block: clamp(2.75rem, 5vw, 4rem) 1.75rem;
  }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }

  .foot-brand p {
    margin-top: 1rem;
    max-width: 40ch;
    font-size: 0.915rem;
    line-height: 1.6;
    color: color-mix(in oklab, white 62%, transparent);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .foot-col h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    letter-spacing: -0.015em;
  }

  .foot-col-h2 {
    margin-top: 1.5rem;
  }

  .foot-col ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .foot-two {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.45rem 1.25rem !important;
  }

  .foot-col a {
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
    color: color-mix(in oklab, white 72%, transparent);
    transition: color 0.16s var(--ease);
  }

  .foot-two a,
  .foot-col-wide a {
    white-space: nowrap;
  }

  .foot-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .foot-cat i {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--tone-bg);
    border: 1px solid color-mix(in oklab, white 25%, transparent);
  }

  .foot-col a:hover {
    color: var(--color-brand-accent);
  }

  .foot-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 2.5rem;
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-invert);
  }

  .foot-bottom::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 4.5rem;
    border-top: 2px solid var(--color-brand-accent);
  }

  .foot-disclose {
    max-width: 62ch;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: color-mix(in oklab, white 78%, transparent);
  }

  .foot-disclose a {
    color: var(--color-brand-accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1.5px;
  }

  .foot-sign {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.45rem;
  }

  .foot-sign-line {
    max-width: 26ch;
    font-family: var(--font-heading);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    letter-spacing: -0.016em;
    color: color-mix(in oklab, white 82%, transparent);
  }

  .foot-copy {
    font-size: var(--fs-caption);
    color: color-mix(in oklab, white 50%, transparent);
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .foot-top {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 2.4fr);
    }

    .foot-cols {
      grid-template-columns: 1.15fr 1.3fr 1.05fr 1.05fr;
    }

    .foot-two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .foot-sign {
      align-items: end;
      text-align: right;
    }
  }
</style>
