---
/**
 * The verdict block on a comparison page.
 *
 * The one inverted section on these pages, so the answer is the loudest thing
 * on the page rather than the table. Emphasis inside the slot is done with
 * `<em>`, which is drawn as an amber underline — the same gesture the
 * homepage's stance block uses, not a recoloured word.
 */
interface Call {
  name: string;
  /** Who should pick it. Completes "Pick X if…". */
  who: string;
}

interface Props {
  title?: string;
  calls: Call[];
}

const { title = 'Which one to pick', calls } = Astro.props;
---

<section class="vd" aria-labelledby="verdict">
  <div class="wrap">
    <h2 id="verdict">{title}</h2>

    <div class="vd-grid">
      {
        calls.map((c) => (
          <div class="vd-call">
            <h3>Pick {c.name} if</h3>
            <p>{c.who}</p>
          </div>
        ))
      }
    </div>

    <div class="vd-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .vd {
    background: var(--color-brand-secondary);
    color: white;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  .vd h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    font-weight: 650;
  }

  .vd-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--line-invert);
    border: 1px solid var(--line-invert);
  }

  .vd-call {
    background: var(--color-brand-secondary);
    padding: clamp(1.15rem, 2.5vw, 1.75rem);
  }

  .vd-call h3 {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
    color: var(--color-brand-accent);
  }

  .vd-call p {
    margin-top: 0.6rem;
    max-width: 44ch;
    font-size: 0.975rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
  }

  .vd-body {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .vd-body :global(p) {
    max-width: 68ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.84);
  }

  .vd-body :global(p + p) {
    margin-top: 0.9rem;
  }

  .vd-body :global(em) {
    font-style: normal;
    color: white;
    text-decoration: underline;
    text-decoration-color: var(--color-brand-accent);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 52rem) {
    .vd-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
