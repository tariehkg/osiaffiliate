---
import Button from './Button.astro';

/**
 * The closing strip.
 *
 * This used to be a full section — heading, description, then a bordered
 * two-cell lattice — which was the third appearance of that exact shape on
 * one page. It is now deliberately the page's lightest section rather than
 * one matching Stance or the methodology band for weight: it is a colophon
 * line before the footer, not a destination.
 *
 * What changed and why:
 *
 * 1. Slim full-bleed band on --color-brand-surface. The page now steps down
 *    in tone on the way out: warm paper (directory) -> warm grey (here) ->
 *    navy (footer). No box is drawn inside it.
 *
 * 2. The heading and its description run side by side as one masthead line
 *    instead of stacking into a full section header, which is most of the
 *    height saving.
 *
 * 3. The two asks are two genuinely different objects, not two cells of one
 *    container: unequal widths, one shared hairline above them, and the only
 *    live control on the strip — "Suggest a tool" — is the solid cobalt pill,
 *    while the provisional half is set off by a dashed rule and muted
 *    controls. Nothing is boxed.
 *
 * 4. The email field is still genuinely `disabled`, its button still says
 *    "Not open yet", and the note under it still explains in plain words that
 *    there is no mailing list. The dashed borders are the signal that neither
 *    control is live; the styling deliberately makes the field look less
 *    functional than the cobalt pill beside it, not more.
 */
interface Props {
  heading?: string;
  description?: string;
  askTitle?: string;
  askLede?: string;
  askCtaLabel?: string;
  askCtaHref?: string;
  waitTitle?: string;
  waitLede?: string;
  emailPlaceholder?: string;
  waitBtnLabel?: string;
  waitNote?: string;
  waitNoteLinkLabel?: string;
  waitNoteLinkHref?: string;
}

const {
  heading = 'Nothing here is final',
  description = 'Picks come out when they stop earning the slot, and a category goes in when there is a real shortlist to show. Tell us what to look at, or ask to hear when something moves.',
  askTitle = 'Tell us what we’re missing',
  askLede = 'Say what you use and what it replaced. We read every one, and the ones that change a shortlist get added with the reasoning shown.',
  askCtaLabel = 'Suggest a tool',
  askCtaHref = '/contact',
  waitTitle = 'Hear when a pick changes',
  waitLede = 'We add a category or swap a pick every few weeks. One short note when that happens — what changed, and why it changed.',
  emailPlaceholder = 'you@yourcompany.com',
  waitBtnLabel = 'Not open yet',
  waitNote = 'There is no mailing list running yet, so this field does nothing on purpose — we would rather show you the plan than collect an address we cannot mail.',
  waitNoteLinkLabel = 'Ask us directly',
  waitNoteLinkHref = '/contact',
} = Astro.props;
---

<section class="close">
  <div class="wrap">
    <header class="close-head" data-rise>
      <h2>{heading}</h2>
      <p>{description}</p>
    </header>

    <div class="close-asks" data-rise>
      <div class="ask ask-live">
        <h3>{askTitle}</h3>
        <p class="ask-lede">{askLede}</p>
        <Button href={askCtaHref} variant="solid" class="ask-go">{askCtaLabel}</Button>
      </div>

      <div class="ask ask-wait">
        <h3>{waitTitle}</h3>
        <p class="ask-lede">{waitLede}</p>

        <div class="ask-form">
          <label class="ask-field">
            <span class="sr">Email address</span>
            <input
              type="email"
              placeholder={emailPlaceholder}
              disabled
              aria-describedby="close-note"
            />
          </label>
          <Button class="ask-btn" disabled>{waitBtnLabel}</Button>
        </div>

        <p class="ask-note" id="close-note">
          {waitNote} <a href={waitNoteLinkHref} class="tlink">{waitNoteLinkLabel}</a> and we will
          add you by hand.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Deliberately the shortest section on the page. */
  .close {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--line);
    padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(2.5rem, 5.5vw, 3.75rem);
  }

  .close-head {
    display: grid;
    gap: 0.6rem;
  }

  .close-head h2 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .close-head p {
    font-size: var(--fs-small);
    line-height: 1.62;
    max-width: 62ch;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  /* One hairline over both asks, and none between or around them. */
  .close-asks {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--line-strong);
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .ask h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.022em;
  }

  .ask-lede {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    max-width: 46ch;
    color: color-mix(in oklab, var(--color-brand-text) 68%, transparent);
  }

  .ask-go {
    margin-top: 1.1rem;
  }

  /* The provisional half: dashed rule, not a box. Becomes a top rule when the
     two asks stack. */
  .ask-wait {
    border-top: 1px dashed var(--line-strong);
    padding-top: clamp(1.25rem, 3.5vw, 1.75rem);
  }

  .ask-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    width: 100%;
    max-width: 27rem;
  }

  /* Dashed: this control is not live. */
  .ask-field {
    /* 14rem basis rather than 11rem: on a 375px screen the field and the
       button together cannot fit without clipping the placeholder, so this
       basis forces the button onto its own line there and keeps them
       side by side everywhere it actually fits. */
    flex: 1 1 14rem;
    display: flex;
    align-items: center;
    min-height: 2.9rem;
    padding-inline: 0.9rem;
    background: var(--color-brand-bg);
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
  }

  .ask-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: none;
    outline: none;
    font-size: var(--fs-small);
    color: var(--color-brand-muted);
    cursor: not-allowed;
  }

  .ask-btn {
    flex: none;
    min-height: 2.9rem;
    border-radius: 10px;
    background: transparent;
    border-color: var(--line-strong);
    color: var(--color-brand-muted);
    font-weight: var(--fw-medium);
    cursor: not-allowed;
  }

  .ask-note {
    margin-top: 0.8rem;
    max-width: 52ch;
    font-size: var(--fs-caption);
    line-height: 1.58;
    color: var(--color-brand-muted);
  }

  @media (min-width: 60rem) {
    /* Heading and description as one line, not a stacked section header. */
    .close-head {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.42fr);
      align-items: baseline;
      gap: clamp(2rem, 5vw, 4rem);
    }

    /* Unequal on purpose — two objects, not two cells. */
    .close-asks {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .ask-wait {
      border-top: 0;
      padding-top: 0;
      border-left: 1px dashed var(--line-strong);
      padding-left: clamp(1.5rem, 3.5vw, 2.5rem);
    }
  }
</style>
