---
import PageHead from './PageHead.astro';
import DisclosureNote from './DisclosureNote.astro';
import SampleNotice from './SampleNotice.astro';
import FilterRail from './FilterRail.astro';
import ProductCard from './ProductCard.astro';
import Stars from './Stars.astro';
import CategoryGuide from './CategoryGuide.astro';
import Faq from './Faq.astro';
import PageTrust from './PageTrust.astro';
import Button from './Button.astro';
import { categories, type Category } from './data';
import { hubNote } from './picks-detail';
import { categoryContent } from './category-content';
import { productContent, pricingLabel } from './product-content';
import { getRating, totalRatings, fmtAverage } from './ratings';

/**
 * A category hub page, whole.
 *
 * Every one of the five hubs is this component with a different category id,
 * so the five pages cannot drift apart. Every pick's row carries
 * `id={pick.slug}` exactly as `data.ts` spells it, so `${hub}#${slug}` links
 * from anywhere on the site still land.
 *
 * The shape is the one the big directories use, because it is the shape a
 * buyer expects — filters on the left, a ranked list on the right, a
 * comparison grid, a buyer's guide and FAQs below — drawn in this site's own
 * language: one hairline between rows, no cards, no shadows, numbered
 * because the list is a ranking.
 *
 * What is different from a big directory, on purpose: the list is short and
 * editor-chosen, the reader rating sits beside the editorial pick rather than
 * replacing it, and the affiliate disclosure is at the top in body type.
 */
interface Props {
  id: Category['id'];
}

const { id } = Astro.props;

const category = categories.find((c) => c.id === id);
if (!category) throw new Error(`CategoryHub: no category with id "${id}"`);
const content = categoryContent[id];
if (!content) throw new Error(`CategoryHub: no category content for "${id}"`);

const others = categories.filter((c) => c.id !== id);
const count = category.picks.length;
const ratingsTotal = totalRatings(category.picks.map((p) => p.slug));
const updated = new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<PageHead
  trail={[{ label: 'Home', href: '/' }]}
  title={content.h1}
  lede={content.intro}
  note={hubNote[id]}
>
  <DisclosureNote links />
  <SampleNotice class="hub-sample" />
</PageHead>

<section class="catalog" id="browse" aria-labelledby="shortlist" data-catalog>
  <div class="wrap">
    <div class="catalog-bar">
      <div class="catalog-bar-l">
        <h2 id="shortlist" class="catalog-h">
          {count} {count === 1 ? 'pick' : 'picks'}, ranked by our editors
        </h2>
        <p class="catalog-meta">
          <span data-listing-status>All {count} picks</span>
          <span aria-hidden="true">·</span>
          <span>{ratingsTotal} reader {ratingsTotal === 1 ? 'rating' : 'ratings'}</span>
          <span aria-hidden="true">·</span>
          <span>Checked {updated}</span>
        </p>
      </div>
      <label class="catalog-sort">
        <span>Sort by</span>
        <select data-sort>
          <option value="editorial">Editor's order</option>
          <option value="rating">Highest rated</option>
          <option value="count">Most rated</option>
        </select>
      </label>
    </div>

    <div class="catalog-grid">
      <FilterRail category={category} />

      <div class="listing" data-listing>
        {category.picks.map((p, i) => <ProductCard category={category} pick={p} rank={i + 1} />)}
      </div>
    </div>

    {
      category.comparison && (
        <div class="vs">
          <div class="vs-copy">
            <h3>Two of these get compared constantly</h3>
            <p>
              If you have already narrowed it to those two, skip the list and read the
              head-to-head: the dimensions that actually separate them, and a straight answer
              about which one to pick.
            </p>
          </div>
          <Button href={category.comparison.href} variant="solid" class="vs-go">
            {category.comparison.label}
          </Button>
        </div>
      )
    }
  </div>
</section>

<section class="grid-sec" aria-labelledby="at-a-glance">
  <div class="wrap">
    <h2 id="at-a-glance" class="grid-h">The shortlist at a glance</h2>
    <p class="grid-lede">
      The same {count} picks as a table, for the moment you want to see them side by side.
    </p>
    <div class="grid-scroll">
      <table class="grid">
        <caption class="sr">{category.name} picks compared on rating, pricing and fit</caption>
        <thead>
          <tr>
            <th scope="col">Pick</th>
            <th scope="col">Reader rating</th>
            <th scope="col">How you start</th>
            <th scope="col">Best for</th>
            <th scope="col">Skip if</th>
          </tr>
        </thead>
        <tbody>
          {
            category.picks.map((p) => {
              const r = getRating(p.slug);
              const c = productContent[p.slug];
              return (
                <tr>
                  <th scope="row">
                    <a href={`${category.hub}/${p.slug}`}>{p.name}</a>
                  </th>
                  <td>
                    {r.count > 0 ? (
                      <span class="grid-rating">
                        <Stars value={r.average} size={13} />
                        <b>{fmtAverage(r.average)}</b>
                        <span>({r.count})</span>
                      </span>
                    ) : (
                      <span class="grid-none">Not rated yet</span>
                    )}
                  </td>
                  <td>
                    {c && <b class="grid-price">{pricingLabel[c.pricing]}</b>}
                    <span class="grid-plan">{p.plan}</span>
                  </td>
                  <td>{c?.bestFor.join(', ')}</td>
                  <td>{c?.skipIf.join(', ')}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<CategoryGuide name={category.short} content={content} />

<Faq faqs={content.faqs} title={`${category.short} questions people ask`} />

<PageTrust />

<section class="next" aria-labelledby="next-cats">
  <div class="wrap">
    <h2 id="next-cats">The other four categories</h2>
    <ul class="next-list">
      {
        others.map((c) => (
          <li>
            <a href={c.hub}>{c.name}</a>
            <span>{c.question}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  :global(.hub-sample) {
    margin-top: 1rem;
  }

  /* ------------------------------------------------------------ catalog */
  .catalog {
    padding-block: clamp(1rem, 2vw, 1.75rem) clamp(2rem, 4vw, 3rem);
  }

  .catalog-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .catalog-h {
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 650;
  }

  .catalog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-muted);
  }

  .catalog-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .catalog-sort select {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--color-brand-bg);
    font-family: var(--font-heading);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-brand-text);
  }

  .catalog-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .listing {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .catalog-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    .catalog-grid > :global(.fr) {
      position: sticky;
      top: 6rem;
    }
  }

  /* --------------------------------------------------- comparison band */
  .vs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem 2.5rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.15rem, 2.5vw, 1.75rem);
    background: var(--tint);
    border: 1px solid color-mix(in oklab, var(--color-brand-primary) 22%, transparent);
    border-radius: 3px;
  }

  .vs-copy h3 {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
  }

  .vs-copy p {
    margin-top: 0.45rem;
    max-width: 58ch;
    font-size: 0.925rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .vs-go {
    flex: none;
  }

  /* --------------------------------------------------- at a glance grid */
  .grid-sec {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .grid-h {
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 650;
  }

  .grid-lede {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  .grid-scroll {
    margin-top: 1.1rem;
    overflow-x: auto;
  }

  .grid {
    width: 100%;
    min-width: 46rem;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--line);
    text-align: left;
    font-size: var(--fs-small);
  }

  .grid thead th {
    padding: 0.8rem 1rem;
    background: var(--color-brand-surface);
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
    border-bottom: 1px solid var(--line-strong);
  }

  .grid tbody th,
  .grid tbody td {
    padding: 0.9rem 1rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }

  .grid tbody tr:first-child th,
  .grid tbody tr:first-child td {
    border-top: 0;
  }

  .grid tbody th {
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }

  .grid tbody th a {
    text-decoration: none;
  }

  .grid tbody th a:hover {
    color: var(--color-brand-primary);
  }

  .grid-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .grid-rating b {
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
  }

  .grid-rating span,
  .grid-none {
    color: var(--color-brand-muted);
  }

  .grid-price {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    color: var(--color-brand-primary);
  }

  .grid-plan {
    display: block;
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  /* -------------------------------------------------------- other cats */
  .next {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .next h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 650;
  }

  .next-list {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .next-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.25rem;
    background: var(--color-brand-bg);
    padding: 0.95rem 1.15rem;
    transition: background-color 0.16s var(--ease);
  }

  .next-list li:hover {
    background: var(--tint);
  }

  .next-list a {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    text-decoration: none;
    flex: none;
  }

  .next-list a:hover {
    color: var(--color-brand-primary);
  }

  .next-list span {
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--color-brand-text) 58%, transparent);
  }

  @media (max-width: 54rem) {
    .next-list span {
      width: 100%;
    }
  }
</style>
