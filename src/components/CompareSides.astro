---
import { categories } from './data';
import { pickDetail } from './picks-detail';

/**
 * The two contenders, stated plainly before the table.
 *
 * Reads both picks out of `data.ts` by slug so a comparison page can never
 * describe a tool differently from the way its own hub page does, and links
 * each one back to its full entry on that hub.
 */
interface Props {
  /** Category id the pair belongs to. */
  category: string;
  /** The two pick slugs, in the order the page names them. */
  slugs: [string, string];
}

const { category: catId, slugs } = Astro.props;

const category = categories.find((c) => c.id === catId);
if (!category) throw new Error(`CompareSides: no category with id "${catId}"`);

const sides = slugs.map((slug) => {
  const pick = category.picks.find((p) => p.slug === slug);
  if (!pick) throw new Error(`CompareSides: no pick "${slug}" in category "${catId}"`);
  return { pick, detail: pickDetail[slug] };
});
---

<section class="cs" aria-label="The two tools compared">
  <div class="wrap">
    <div class="cs-grid">
      {
        sides.map(({ pick, detail }) => (
          <article class="cs-side">
            <div class="cs-top">
              <span class="mono" aria-hidden="true">
                {pick.monogram}
              </span>
              <h2>{pick.name}</h2>
            </div>

            <p class="cs-role">{pick.role}</p>
            <p class="cs-plan">{pick.plan}</p>

            <div class="cs-acts">
              <a href={detail.url} class="pill pill-line cs-go" rel="nofollow noopener">
                {detail.urlLabel}
              </a>
              <a href={`${category.hub}#${pick.slug}`} class="tlink cs-more">
                Full entry on the shortlist
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs {
    padding-block: clamp(0.75rem, 2vw, 1.5rem) 0;
  }

  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .cs-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    background: var(--color-brand-bg);
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
  }

  .cs-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mono {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 7px;
    background: var(--color-brand-secondary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .cs-top h2 {
    font-size: clamp(1.2rem, 2.3vw, 1.5rem);
    font-weight: 650;
  }

  .cs-role {
    max-width: 40ch;
    font-size: 0.93rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .cs-plan {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--color-brand-primary);
  }

  .cs-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.6rem;
  }

  .cs-more {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-brand-muted);
  }

  @media (min-width: 52rem) {
    .cs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
