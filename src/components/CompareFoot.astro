---
import { categories } from './data';

/**
 * The link back up the silo.
 *
 * A comparison page is a cluster page under its category hub, so it ends by
 * pointing at the hub and at the picks this head-to-head left out — which is
 * usually the honest next question ("is it even one of these two?").
 */
interface Props {
  category: string;
  /** Slugs covered by the comparison, so the rest can be listed as the others. */
  slugs: string[];
}

const { category: catId, slugs } = Astro.props;

const category = categories.find((c) => c.id === catId);
if (!category) throw new Error(`CompareFoot: no category with id "${catId}"`);

const rest = category.picks.filter((p) => !slugs.includes(p.slug));
---

<section class="cf" aria-labelledby="back-up">
  <div class="wrap">
    <h2 id="back-up">Not sure it is one of these two?</h2>
    <p class="cf-lede">
      {
        rest.length > 0
          ? `The ${category.name.toLowerCase()} shortlist has ${rest.length === 1 ? 'one more pick' : `${rest.length} more picks`} on it, with the same reasoning and the same caveat for each.`
          : `The ${category.name.toLowerCase()} shortlist has only these two on it, and the hub page explains why nothing else made the cut.`
      }
    </p>

    <ul class="cf-list">
      <li class="cf-hub">
        <a href={category.hub}>The whole {category.name} shortlist</a>
        <span>{category.question}</span>
      </li>
      {
        rest.map((p) => (
          <li>
            <a href={`${category.hub}#${p.slug}`}>{p.name}</a>
            <span>{p.role}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cf {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .cf h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 650;
  }

  .cf-lede {
    margin-top: 0.7rem;
    max-width: 60ch;
    font-size: 0.975rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .cf-list {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .cf-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.25rem;
    background: var(--color-brand-bg);
    padding: 0.95rem 1.15rem;
    transition: background-color 0.16s var(--ease);
  }

  .cf-list li:hover {
    background: var(--tint);
  }

  .cf-list a {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    text-decoration: none;
    flex: none;
  }

  .cf-list a:hover {
    color: var(--color-brand-primary);
  }

  /* The hub row is the one that goes up a level, so it sits on the surface
     tone instead of the paper tone. Specificity matched to the :hover rule
     above rather than fought with !important. */
  .cf-list li.cf-hub {
    background: var(--color-brand-surface);
  }

  .cf-list li.cf-hub:hover {
    background: var(--tint-strong);
  }

  .cf-list span {
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--color-brand-text) 58%, transparent);
  }

  @media (max-width: 54rem) {
    .cf-list span {
      width: 100%;
    }
  }
</style>
