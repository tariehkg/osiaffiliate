---
/**
 * A run of blog posts, newest first — used on /blog and on author profiles.
 *
 * Not a card grid. With `feature`, the first post is set as a lead: the photo
 * wide on the left, the title at section-heading scale beside it. Every other
 * post is a row in a ruled ledger (date | title and summary | thumbnail) — the
 * same hairline lattice the directory and comparison tables use, so the blog
 * reads as part of the site rather than a template bolted onto it.
 *
 * `feature` is only ever used at the top of a page, so the lead photo is
 * loaded eagerly as an above-the-fold image. Row thumbnails are lazy.
 *
 * Pass posts that have already been through getPublishedPosts() — this
 * component does not filter drafts itself.
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { formatDate, readingMinutes, type Post } from './blog';

interface Props {
  posts: Post[];
  /** Set the first post as a large lead above the ledger. */
  feature?: boolean;
  /** Accessible name for the list, e.g. "All posts". */
  label?: string;
}

const { posts, feature = false, label = 'Posts' } = Astro.props;

const lead = feature ? posts[0] : undefined;
const rows = feature ? posts.slice(1) : posts;
const leadAuthor = lead ? await getEntry(lead.data.author) : undefined;
---

<div class="pl">
  {
    lead && (
      <article class="pl-lead">
        <a href={`/blog/${lead.id}`} class="pl-lead-media" tabindex="-1" aria-hidden="true">
          <Image
            src={lead.data.featuredImage.src}
            alt={lead.data.featuredImage.alt}
            width={720}
            height={480}
            widths={[480, 720, 960, 1440]}
            sizes="(min-width: 78rem) 720px, (min-width: 52rem) 58vw, 92vw"
            quality={80}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </a>
        <div class="pl-lead-text">
          <p class="pl-date">
            <time datetime={lead.data.pubDate.toISOString()}>{formatDate(lead.data.pubDate)}</time>
          </p>
          <h2 class="pl-lead-h">
            <a href={`/blog/${lead.id}`}>{lead.data.title}</a>
          </h2>
          <p class="pl-lead-desc">{lead.data.description}</p>
          <p class="pl-lead-by">
            {leadAuthor && (
              <>
                By <a href={`/authors/${leadAuthor.id}`}>{leadAuthor.data.name}</a>,{' '}
              </>
            )}
            {readingMinutes(lead.body)} minute read
          </p>
        </div>
      </article>
    )
  }

  {
    rows.length > 0 && (
      <ol class="pl-rows" aria-label={label}>
        {rows.map((p) => (
          <li class="pl-row">
            <p class="pl-date">
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            </p>
            <div class="pl-row-text">
              <h3 class="pl-row-h">
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </h3>
              <p class="pl-row-desc">{p.data.description}</p>
              <p class="pl-row-meta">{readingMinutes(p.body)} minute read</p>
            </div>
            <div class="pl-row-thumb">
              <Image
                src={p.data.featuredImage.src}
                alt={p.data.featuredImage.alt}
                width={216}
                height={144}
                widths={[108, 216, 432]}
                sizes="(min-width: 44rem) 216px, 108px"
                quality={80}
              />
            </div>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  /* ---- Lead -------------------------------------------------------------- */
  .pl-lead {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .pl-lead-media {
    display: block;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-brand);
  }

  .pl-lead-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .pl-lead-text {
    align-self: center;
  }

  .pl-lead-h {
    margin-top: 0.6rem;
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
    font-weight: var(--fw-bold);
    letter-spacing: -0.034em;
    line-height: 1.06;
    max-width: 18ch;
  }

  .pl-lead-desc {
    margin-top: 1rem;
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }

  .pl-lead-by {
    margin-top: 1.1rem;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
  }

  .pl-lead-by a {
    color: var(--color-brand-text);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 50%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.24em;
  }

  .pl-lead-by a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  @media (min-width: 52rem) {
    .pl-lead {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ---- Shared ------------------------------------------------------------ */
  .pl-date {
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-muted);
  }

  /* Titles are the link. The underline arrives on hover in cobalt, which is
     the site's one signal for "this goes somewhere". */
  .pl-lead-h a,
  .pl-row-h a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .pl-lead-h a:hover,
  .pl-row-h a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  /* ---- Ledger rows ------------------------------------------------------- */
  .pl-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .pl-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.75rem;
    grid-template-areas:
      'date  thumb'
      'text  thumb';
    align-items: start;
    gap: 0.35rem 1.1rem;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--line);
  }

  /* The amber lead segment marks the newest row in the ledger — the same
     gesture the footer uses to mark the line it wants read. Only when there
     is no lead above it, so there is never more than one amber mark. */
  .pl-rows:first-child .pl-row:first-child::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 4.5rem;
    border-top: 2px solid var(--color-brand-accent);
  }

  .pl-row .pl-date {
    grid-area: date;
  }

  .pl-row-text {
    grid-area: text;
  }

  .pl-row-thumb {
    grid-area: thumb;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .pl-row-thumb :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .pl-row-h {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.022em;
    line-height: 1.18;
    max-width: 34ch;
  }

  .pl-row-desc {
    margin-top: 0.5rem;
    max-width: 62ch;
    font-size: 0.97rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .pl-row-meta {
    margin-top: 0.6rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  /* Wider: the date gets its own column, so the ledger reads down the left
     edge like the directory does. */
  @media (min-width: 44rem) {
    .pl-row {
      grid-template-columns: 10rem minmax(0, 1fr) 13.5rem;
      grid-template-areas: 'date text thumb';
      gap: 2rem;
    }

    .pl-row .pl-date {
      padding-top: 0.2rem;
    }

    .pl-row-h {
      font-size: var(--fs-h3);
    }
  }
</style>
