---
/**
 * The one-line notice shown wherever a rating appears while SAMPLE_MODE is on.
 *
 * Same device as the affiliate disclosure: body size, an amber marker, said
 * once and plainly. Renders nothing once ratings are real.
 */
import { SAMPLE_MODE } from './ratings';

interface Props {
  class?: string;
}

const { class: cls = '' } = Astro.props;
---

{
  SAMPLE_MODE && (
    <p class:list={['sn', cls]}>
      <b>Sample figures.</b> Reader ratings open soon; the stars and counts shown are placeholders
      so you can see how the page will read, not measurements of anything.
    </p>
  )
}

<style>
  .sn {
    max-width: 62ch;
    padding: 0.55rem 0 0.55rem 0.9rem;
    border-left: 3px solid var(--color-brand-accent);
    font-size: var(--fs-caption);
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  .sn b {
    font-weight: var(--fw-semibold);
    color: color-mix(in oklab, var(--color-brand-text) 84%, transparent);
  }
</style>
