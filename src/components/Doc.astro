---
/**
 * Reading column for the four site-wide pages.
 *
 * These pages are prose, and prose wants one narrow measure, not a grid of
 * cards. Sections are separated by the same hairline the rest of the site uses
 * for shared cell edges — the lattice reduced to a single rule.
 *
 * Styling is applied from here with :global so the pages themselves stay
 * content: plain h2/h3/p/ul markup, no classes to remember.
 */
---

<div class="doc">
  <div class="wrap">
    <div class="doc-col">
      <slot />
    </div>
  </div>
</div>

<style>
  .doc {
    padding-block: 0 clamp(2.5rem, 5vw, 4rem);
  }

  .doc-col {
    max-width: 44rem;
  }

  .doc-col :global(section + section) {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .doc-col :global(h2) {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    font-weight: 650;
    max-width: 30ch;
  }

  .doc-col :global(h3) {
    margin-top: clamp(1.4rem, 2.5vw, 1.9rem);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .doc-col :global(p) {
    margin-top: 0.85rem;
    font-size: 1.01rem;
    line-height: 1.7;
    color: color-mix(in oklab, var(--color-brand-text) 86%, transparent);
  }

  .doc-col :global(ul) {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  /* List markers are the amber standing bar from the mark, at list scale. */
  .doc-col :global(li) {
    position: relative;
    padding-left: 1.1rem;
    font-size: 1.01rem;
    line-height: 1.65;
    color: color-mix(in oklab, var(--color-brand-text) 86%, transparent);
  }

  .doc-col :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 3px;
    height: 0.85em;
    border-radius: 2px;
    background: var(--color-brand-accent);
  }

  .doc-col :global(li b) {
    font-weight: 600;
  }

  /* A quiet inset for the honest limits — surface tone, no shadow, no radius
     beyond the site's 3px. */
  .doc-col :global(.doc-inset) {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    background: var(--color-brand-surface);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .doc-col :global(.doc-inset > :first-child) {
    margin-top: 0;
  }

  .doc-col :global(.doc-lead) {
    font-size: clamp(1.1rem, 1.8vw, 1.28rem);
    line-height: 1.6;
    color: var(--color-brand-text);
  }

  .doc-col :global(a:not(.pill)) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 50%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.24em;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .doc-col :global(a:not(.pill):hover) {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }
</style>
