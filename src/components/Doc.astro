---
import Prose from './Prose.astro';

/**
 * Reading column for the site-wide pages (about, methodology, disclosure,
 * privacy, contact): one narrow measure inside the page wrap, typeset by
 * Prose. Pages stay plain h2/h3/p/ul markup with no classes to remember.
 */
---

<div class="doc">
  <div class="wrap">
    <Prose class="doc-col">
      <slot />
    </Prose>
  </div>
</div>

<style>
  .doc {
    padding-block: 0 clamp(2.5rem, 5vw, 4rem);
  }

  .doc :global(.doc-col) {
    max-width: 44rem;
  }
</style>
