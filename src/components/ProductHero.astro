---
/**
 * The top of a product page: tile, name, vendor, category, the rating line,
 * and the two actions — visit the vendor, or rate it here. Under it, the
 * in-page navigation, which sticks under the site nav so a reader can jump
 * from ratings to pricing to alternatives without scrolling back up.
 */
import Button from './Button.astro';
import RatingBadge from './RatingBadge.astro';
import type { Pick, Category } from './data';
import { pickDetail } from './picks-detail';
import { productContent, pricingLabel } from './product-content';

interface Props {
  category: Category;
  pick: Pick;
  rank: number;
}

const { category, pick, rank } = Astro.props;
const detail = pickDetail[pick.slug];
const content = productContent[pick.slug];

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'ratings', label: 'Ratings' },
  { id: 'pricing', label: 'Pricing' },
  { id: 'fit', label: 'Best for' },
  { id: 'alternatives', label: 'Alternatives' },
  { id: 'faq', label: 'Questions' },
];
---

<header class="ph-prod">
  <div class="wrap">
    <div class="php-grid">
      <span class="php-tile" aria-hidden="true">{pick.monogram}</span>

      <div class="php-id">
        <p class="php-kicker">
          <a href={category.hub}>{category.name}</a>
          <span aria-hidden="true">·</span>
          <span>Our pick #{rank} of {category.picks.length}</span>
        </p>
        <h1 class="php-h">{pick.name}</h1>
        {content && <p class="php-vendor">by {content.vendor}</p>}
        <RatingBadge slug={pick.slug} size={18} href="#ratings" class="php-rating" />
        <p class="php-tag">{content?.tagline ?? pick.role}</p>
      </div>

      <div class="php-acts">
        <Button href={detail.url} variant="solid" rel="nofollow noopener sponsored">
          {detail.urlLabel}
        </Button>
        <a href="#rate" class="pill pill-line">Rate {pick.name}</a>
        <p class="php-plan">
          {content && <b>{pricingLabel[content.pricing]}.</b>} {pick.plan}
        </p>
      </div>
    </div>
  </div>

  <nav class="php-nav" aria-label="On this page">
    <div class="wrap">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .ph-prod {
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }

  .php-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'tile id'
      'acts acts';
    gap: 1.25rem;
    align-items: start;
  }

  .php-tile {
    grid-area: tile;
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 8vw, 5rem);
    height: clamp(3.5rem, 8vw, 5rem);
    border-radius: 10px;
    background: var(--color-brand-secondary);
    color: white;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .php-id {
    grid-area: id;
    min-width: 0;
  }

  .php-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  .php-kicker a {
    color: var(--color-brand-primary);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
  }

  .php-kicker a:hover {
    text-decoration-color: currentColor;
  }

  .php-h {
    margin-top: 0.35rem;
    font-size: clamp(2.1rem, 5.6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.038em;
    line-height: 1.04;
  }

  .php-vendor {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--color-brand-muted);
  }

  :global(.php-rating) {
    margin-top: 0.85rem;
  }

  .php-tag {
    margin-top: 0.9rem;
    max-width: 58ch;
    font-size: clamp(1.01rem, 1.3vw, 1.14rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }

  .php-acts {
    grid-area: acts;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .php-plan {
    width: 100%;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  .php-plan b {
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    color: var(--color-brand-primary);
  }

  /* Sticky under the site nav on wide screens (the site nav is 3.5rem tall
     once scrolled; below 70rem it grows a category strip, so there the ruler
     scrolls with the page instead of fighting for the top edge). One
     hairline, no shadow: it reads as the page's own ruler, not a toolbar. */
  .php-nav {
    z-index: 40;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    background: color-mix(in oklab, var(--color-brand-bg) 94%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .php-nav ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .php-nav ul::-webkit-scrollbar {
    display: none;
  }

  .php-nav a {
    display: block;
    padding: 0.8rem 0;
    font-family: var(--font-heading);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    text-decoration: none;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  .php-nav a:hover {
    color: var(--color-brand-text);
    border-bottom-color: var(--color-brand-primary);
  }

  @media (min-width: 70rem) {
    .php-nav {
      position: sticky;
      top: 3.5rem;
    }
  }

  @media (min-width: 60rem) {
    .php-grid {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'tile id acts';
      gap: 1.5rem clamp(1.5rem, 3vw, 2.5rem);
    }

    .php-acts {
      flex-direction: column;
      align-items: stretch;
      min-width: 15rem;
      padding-left: clamp(1.5rem, 3vw, 2.5rem);
      border-left: 1px solid var(--line);
    }

    .php-acts :global(.pill) {
      justify-content: center;
    }
  }
</style>
