---
/**
 * The full rating breakdown for one product: the average at display scale,
 * the vote count, how the votes fall across five stars, the four criteria
 * scores, and the share who would recommend it.
 *
 * Bars are the site's lattice reduced to a rule: a hairline track with a
 * cobalt fill, no rounded pills, no gradients. Every bar carries its number
 * as text, so the chart is readable without colour.
 *
 * Renders an empty state, with the same layout, when nobody has rated yet —
 * the page should look like a page that is waiting for votes, not a broken
 * one.
 */
import Stars from './Stars.astro';
import { getRating, criteria, fmtAverage, share } from './ratings';

interface Props {
  slug: string;
  name: string;
  /** Where the "Rate it" link goes — the widget's id on the page. */
  rateHref?: string;
}

const { slug, name, rateHref = '#rate' } = Astro.props;
const r = getRating(slug);
const stars: (5 | 4 | 3 | 2 | 1)[] = [5, 4, 3, 2, 1];
---

<div class="rs" data-rated={r.count > 0 ? 'true' : 'false'}>
  <div class="rs-head">
    {
      r.count > 0 ? (
        <>
          <p class="rs-avg">
            <b>{fmtAverage(r.average)}</b>
            <span class="rs-of">out of 5</span>
          </p>
          <Stars value={r.average} size={22} />
          <p class="rs-count">
            {r.count} reader {r.count === 1 ? 'rating' : 'ratings'} for {name}
          </p>
        </>
      ) : (
        <>
          <p class="rs-avg">
            <b class="rs-dash">–</b>
            <span class="rs-of">out of 5</span>
          </p>
          <Stars value={0} size={22} />
          <p class="rs-count">Nobody has rated {name} yet.</p>
        </>
      )
    }
    <a href={rateHref} class="pill pill-solid rs-go">Rate {name}</a>
  </div>

  <div class="rs-grid">
    <div class="rs-block">
      <h3 class="rs-h">How the votes fall</h3>
      <ol class="rs-bars" aria-label="Ratings by star">
        {
          stars.map((s) => {
            const p = share(r, s);
            return (
              <li class="rs-bar">
                <span class="rs-bar-l">
                  {s} star{s === 1 ? '' : 's'}
                </span>
                <span class="rs-track" aria-hidden="true">
                  <span class="rs-fill" style={`width:${Math.round(p * 100)}%`} />
                </span>
                <span class="rs-bar-n">{r.count ? r.distribution[s - 1] : '–'}</span>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="rs-block">
      <h3 class="rs-h">Scored on</h3>
      <ul class="rs-bars" aria-label="Ratings by criterion">
        {
          criteria.map((c) => {
            const v = r.criteria[c.key];
            return (
              <li class="rs-bar">
                <span class="rs-bar-l">{c.label}</span>
                <span class="rs-track" aria-hidden="true">
                  <span class="rs-fill" style={`width:${r.count ? (v / 5) * 100 : 0}%`} />
                </span>
                <span class="rs-bar-n">{r.count ? fmtAverage(v) : '–'}</span>
              </li>
            );
          })
        }
      </ul>
      <p class="rs-rec">
        {
          r.count > 0 ? (
            <>
              <b>{Math.round(r.recommend * 100)}%</b> of raters would recommend it to a business
              like theirs.
            </>
          ) : (
            <>Would readers recommend it? Nobody has said yet.</>
          )
        }
      </p>
    </div>
  </div>
</div>

<style>
  .rs {
    border: 1px solid var(--line);
    background: var(--color-brand-bg);
  }

  .rs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    border-bottom: 1px solid var(--line);
  }

  .rs-avg {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .rs-avg b {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4vw, 3.25rem);
    font-weight: var(--fw-bold);
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .rs-dash {
    color: color-mix(in oklab, var(--color-brand-text) 30%, transparent);
  }

  .rs-of {
    font-size: var(--fs-small);
    color: var(--color-brand-muted);
  }

  .rs-count {
    flex: 1 1 12rem;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
  }

  .rs-go {
    flex: none;
    margin-left: auto;
  }

  .rs-grid {
    display: grid;
    gap: 1px;
    background: var(--line);
  }

  .rs-block {
    background: var(--color-brand-bg);
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .rs-h {
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
    color: var(--color-brand-muted);
  }

  .rs-bars {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .rs-bar {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-small);
  }

  .rs-bar-l {
    color: color-mix(in oklab, var(--color-brand-text) 76%, transparent);
    white-space: nowrap;
  }

  .rs-track {
    display: block;
    height: 0.55rem;
    background: color-mix(in oklab, var(--color-brand-text) 8%, transparent);
    border: 1px solid var(--line);
  }

  .rs-fill {
    display: block;
    height: 100%;
    background: var(--color-brand-primary);
    transition: width 0.4s var(--ease-out);
  }

  .rs-bar-n {
    text-align: right;
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
  }

  .rs-rec {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .rs-rec b {
    font-family: var(--font-heading);
    font-weight: var(--fw-bold);
    color: var(--color-brand-text);
  }

  @media (min-width: 52rem) {
    .rs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .rs-bar {
      grid-template-columns: 6rem minmax(0, 1fr) 2.25rem;
    }
  }
</style>
