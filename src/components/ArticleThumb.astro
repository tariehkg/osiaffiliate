---
import CoverTile from './CoverTile.astro';
import { thumbTitle, categoryOf, type Article } from './articles';

/**
 * The cover every article carries in a feed, a menu or a card.
 *
 * Works out the title and the one fact under it from the article, then
 * hands them to `CoverTile` — the same component the tile maker on
 * `/design-system` uses, so a real article's cover and a hand-typed
 * preview of one are pixel-identical. Every article gets this: the site
 * never uses a stock photo as a cover.
 */
interface Props {
  article: Article;
  class?: string;
}

const { article, class: cls = '' } = Astro.props;
const d = article.data;
const title = thumbTitle(article);
const cat = categoryOf(article);

/* The one fact under the title. */
let note = '';

switch (d.type) {
  case 'review':
    note = d.product?.score !== undefined ? "Editor's score" : (d.product?.plan ?? '');
    break;
  case 'best':
    note = `${d.picks.length} tools tested and compared`;
    break;
  case 'alternatives':
    note = `${d.picks.length} alternatives compared`;
    break;
  case 'comparison':
    note = 'Head to head';
    break;
  case 'pricing':
    note = d.product?.plan ?? 'Pricing guide';
    break;
  default:
    note = cat?.short ?? 'Guide';
}
---

<CoverTile title={title} note={note} class={cls} />
