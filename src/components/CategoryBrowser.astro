---
import { categories as allCategories } from './data';
import RatingBadge from './RatingBadge.astro';

/**
 * The category browser.
 *
 * Switching categories is pure CSS: five radio inputs sit as siblings ahead
 * of the grid, and `#id:checked ~ .browse-grid .pane-id` reveals the matching
 * pane. No JavaScript, so it works on first paint. The radios keep real
 * keyboard behaviour (tab in, arrow keys between categories).
 *
 * The same :checked selectors also set three custom properties on the grid —
 * `--hue`, `--hue-on`, `--hue-ink` — so choosing a category re-tints the
 * panel it opens: the selected rail marker, the lead pick's top rule and
 * every monogram tile in that shortlist. Cobalt for CRM, amber for email,
 * navy for builders, deep cobalt for project tools, ink for SEO. One
 * repeated black square for all fifteen picks was the thing this section
 * most needed to lose.
 *
 * Inside a pane the shortlist is deliberately not a uniform grid. The first
 * pick gets a tall, elevated card with a filled tile and a name at heading
 * scale; the rest are compact ledger rows beside it. The list is ordered
 * editorially, and the layout should say so before the copy has to.
 *
 * Every pick's wrapper carries `id={pick.slug}` — the same anchor ids the
 * category hubs use — so `#hubspot-crm` resolves on this page too.
 *
 * `categories` defaults to the site's real shortlist data. The zero-JS
 * state machine's CSS selectors are keyed to the five known category ids
 * (`cat-crm`, `cat-email`, `cat-sites`, `cat-pm`, `cat-seo`), so a caller
 * swapping in different data still needs those same ids to keep the
 * pane-switching and hue-tinting working.
 */
interface Props {
  heading?: string;
  lede?: string;
  categories?: typeof allCategories;
}

const {
  heading = 'Start with what you’re replacing',
  lede = 'Five categories, two to four picks in each. Pick a category and you get the whole shortlist — not page one of forty.',
  categories = allCategories,
} = Astro.props;
---

<section class="browse" id="browse">
  <div class="wrap">
    <header class="browse-head" data-rise>
      <h2 class="browse-h">{heading}</h2>
      <p class="browse-lede">{lede}</p>
    </header>

    <div class="browse-shell" data-rise>
      {
        categories.map((c, i) => (
          <input
            class="cat-radio"
            type="radio"
            name="osi-category"
            id={`cat-${c.id}`}
            checked={i === 0}
          />
        ))
      }

      <div class="browse-grid">
        <div class="rail">
          {
            categories.map((c) => (
              <label for={`cat-${c.id}`} class="rail-item">
                <span class="rail-name">{c.name}</span>
                <span class="rail-count">
                  {c.picks.length} {c.picks.length === 1 ? 'pick' : 'picks'}
                </span>
              </label>
            ))
          }
        </div>

        <div class="panes">
          {
            categories.map((c) => {
              const [lead, ...rest] = c.picks;

              return (
                <div class:list={['pane', `pane-${c.id}`]}>
                  <p class="pane-q">{c.question}</p>

                  <div class="picks" data-count={c.picks.length}>
                    <article class="lead" id={lead.slug}>
                      <span class="tile tile-lead" aria-hidden="true">
                        {lead.monogram}
                      </span>

                      <h3 class="lead-name">
                        <a href={`${c.hub}/${lead.slug}`}>{lead.name}</a>
                      </h3>

                      <RatingBadge slug={lead.slug} size={14} class="lead-rating" />
                      <p class="lead-role">{lead.role}</p>
                      <p class="lead-plan">{lead.plan}</p>
                    </article>

                    <div class="rest">
                      {rest.map((p) => (
                        <article class="row" id={p.slug}>
                          <span class="tile" aria-hidden="true">
                            {p.monogram}
                          </span>

                          <div class="row-body">
                            <h3 class="row-name">
                              <a href={`${c.hub}/${p.slug}`}>{p.name}</a>
                            </h3>
                            <p class="row-role">{p.role}</p>
                            <RatingBadge slug={p.slug} size={12} class="row-rating" />
                          </div>

                          <p class="row-plan">{p.plan}</p>
                        </article>
                      ))}
                    </div>
                  </div>

                  <div class="pane-foot">
                    <a href={c.hub} class="tlink">See all {c.name}</a>
                    {c.comparison && (
                      <a href={c.comparison.href} class="tlink pane-compare">
                        {c.comparison.label}
                      </a>
                    )}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The one section on the page that changes rooms: a cool neutral ground so
     the lead pick's white card has something to sit above. */
  .browse {
    background: var(--surface-alt);
    padding-block: clamp(2.75rem, 5.5vw, 4.5rem) clamp(3.25rem, 6.5vw, 5.5rem);
  }

  /* Heading and lede sit side by side at width rather than stacking centred —
     the lede is a caption on the heading, not a subtitle under it. */
  .browse-head {
    display: grid;
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
  }

  .browse-h {
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .browse-lede {
    font-size: var(--fs-lede);
    font-weight: var(--fw-light);
    line-height: 1.5;
    max-width: 42ch;
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }

  .browse-shell {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* Radios are the state machine. Kept in flow but invisible, with real
     focus routed onto the labels below. */
  .cat-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    margin: 0;
    pointer-events: none;
  }

  /* Default tint, replaced per category by the :checked rules at the bottom.
     --hue fills a tile, --hue-on is the monogram drawn on that fill, and
     --hue-ink is the readable version of the hue on a pale ground. */
  .browse-grid {
    --hue: var(--color-brand-primary);
    --hue-on: white;
    --hue-ink: var(--color-brand-primary);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  /* --- left rail --- */
  .rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    align-content: start;
  }

  .rail-item {
    cursor: pointer;
    display: block;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: color-mix(in oklab, white 70%, transparent);
    color: color-mix(in oklab, var(--color-brand-text) 66%, transparent);
    transition:
      background-color 0.16s var(--ease),
      border-color 0.16s var(--ease),
      color 0.16s var(--ease);
  }

  .rail-item:last-child {
    grid-column: 1 / -1;
  }

  .rail-item:hover {
    border-color: var(--line-strong);
    background: white;
    color: var(--color-brand-text);
  }

  .rail-name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
    letter-spacing: -0.018em;
    line-height: 1.25;
  }

  .rail-count {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-caption);
    color: color-mix(in oklab, var(--color-brand-text) 52%, transparent);
  }

  /* --- panes --- */
  .pane {
    display: none;
  }

  .pane-q {
    font-size: var(--fs-lede);
    font-weight: var(--fw-light);
    line-height: 1.4;
    max-width: 38ch;
    color: color-mix(in oklab, var(--color-brand-text) 80%, transparent);
  }

  .picks {
    margin-top: clamp(1.1rem, 2.2vw, 1.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }

  /* --- the lead pick ---------------------------------------------------- */

  /* White where everything around it is grey, lifted by a brand-tinted
     shadow, and topped by the category's own hue. */
  .lead {
    display: flex;
    flex-direction: column;
    align-items: start;
    background: white;
    border: 1px solid var(--line);
    border-top: 3px solid var(--hue);
    border-radius: 3px;
    box-shadow: var(--shadow-brand);
    padding: clamp(1.15rem, 2.4vw, 1.75rem);
  }

  .tile {
    flex: none;
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    border-radius: 4px;
  }

  .tile-lead {
    width: 3rem;
    height: 3rem;
    background: var(--hue);
    color: var(--hue-on);
    font-size: 1.15rem;
  }

  .lead-name {
    margin-top: 1.1rem;
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .lead-role {
    margin-top: 0.5rem;
    font-size: var(--fs-body);
    line-height: 1.5;
    max-width: 30ch;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  /* Amber's real job here: how the vendor sells it, as a chip. Ink on the
     wash rather than amber-on-amber, which does not carry at 13px. */
  .lead-plan {
    margin-top: 1.25rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--amber-line);
    border-radius: 2px;
    background: color-mix(in oklab, var(--color-brand-accent) 22%, var(--color-brand-bg));
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.008em;
    color: color-mix(in oklab, var(--color-brand-text) 90%, transparent);
  }

  /* --- the secondary picks ---------------------------------------------- */
  .rest {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 0.8rem;
    align-items: start;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: color-mix(in oklab, white 55%, transparent);
    transition:
      background-color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  .row:hover {
    background: white;
    border-color: var(--line-strong);
  }

  .row .tile {
    width: 2.2rem;
    height: 2.2rem;
    background: color-mix(in oklab, var(--hue) 9%, white);
    border: 1px solid color-mix(in oklab, var(--hue) 26%, transparent);
    color: var(--hue-ink);
    font-size: 0.82rem;
  }

  .row-name {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    letter-spacing: -0.026em;
    line-height: 1.15;
  }

  .row-role {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-brand-text) 64%, transparent);
  }

  /* A thin amber tick in the margin instead of a second chip — the lead's
     chip should stay the loudest pricing line in the pane. */
  .row-plan {
    grid-column: 2;
    border-left: 2px solid var(--amber-line);
    padding-left: 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
  }

  /* Pick names link to that pick's own section on its hub. The faint
     underline is the same affordance `.tlink` uses — without it the name
     would only read as a link on hover, which is no use on a touch screen. */
  .lead-name a,
  .row-name a {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 22%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .lead-name a:hover,
  .row-name a:hover {
    color: var(--hue-ink);
    text-decoration-color: currentColor;
  }

  .pane-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: clamp(1.1rem, 2.2vw, 1.5rem);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .pane-compare {
    color: color-mix(in oklab, var(--color-brand-text) 58%, transparent);
  }

  /* --- the zero-JS state machine --------------------------------------- */
  #cat-crm:checked ~ .browse-grid .pane-crm,
  #cat-email:checked ~ .browse-grid .pane-email,
  #cat-sites:checked ~ .browse-grid .pane-sites,
  #cat-pm:checked ~ .browse-grid .pane-pm,
  #cat-seo:checked ~ .browse-grid .pane-seo {
    display: block;
  }

  /* Selected category: filled, lifted, and a full weight step heavier than
     its neighbours — not a left border doing the whole job. */
  #cat-crm:checked ~ .browse-grid .rail-item[for='cat-crm'],
  #cat-email:checked ~ .browse-grid .rail-item[for='cat-email'],
  #cat-sites:checked ~ .browse-grid .rail-item[for='cat-sites'],
  #cat-pm:checked ~ .browse-grid .rail-item[for='cat-pm'],
  #cat-seo:checked ~ .browse-grid .rail-item[for='cat-seo'] {
    background: var(--hue);
    border-color: var(--hue);
    color: var(--hue-on);
    box-shadow: var(--shadow-sm);
  }

  #cat-crm:checked ~ .browse-grid .rail-item[for='cat-crm'] .rail-name,
  #cat-email:checked ~ .browse-grid .rail-item[for='cat-email'] .rail-name,
  #cat-sites:checked ~ .browse-grid .rail-item[for='cat-sites'] .rail-name,
  #cat-pm:checked ~ .browse-grid .rail-item[for='cat-pm'] .rail-name,
  #cat-seo:checked ~ .browse-grid .rail-item[for='cat-seo'] .rail-name {
    font-weight: var(--fw-semibold);
  }

  #cat-crm:checked ~ .browse-grid .rail-item[for='cat-crm'] .rail-count,
  #cat-email:checked ~ .browse-grid .rail-item[for='cat-email'] .rail-count,
  #cat-sites:checked ~ .browse-grid .rail-item[for='cat-sites'] .rail-count,
  #cat-pm:checked ~ .browse-grid .rail-item[for='cat-pm'] .rail-count,
  #cat-seo:checked ~ .browse-grid .rail-item[for='cat-seo'] .rail-count {
    color: color-mix(in oklab, var(--hue-on) 78%, transparent);
  }

  /* Choosing a category also re-tints the panel it opens. */
  #cat-email:checked ~ .browse-grid {
    --hue: var(--color-brand-accent);
    --hue-on: var(--color-brand-text);
    --hue-ink: var(--color-brand-text);
  }

  #cat-sites:checked ~ .browse-grid {
    --hue: var(--color-brand-secondary);
    --hue-on: white;
    --hue-ink: var(--color-brand-secondary);
  }

  #cat-pm:checked ~ .browse-grid {
    --hue: var(--color-primary-deep);
    --hue-on: white;
    --hue-ink: var(--color-primary-deep);
  }

  #cat-seo:checked ~ .browse-grid {
    --hue: var(--color-brand-text);
    --hue-on: white;
    --hue-ink: var(--color-brand-text);
  }

  #cat-crm:focus-visible ~ .browse-grid .rail-item[for='cat-crm'],
  #cat-email:focus-visible ~ .browse-grid .rail-item[for='cat-email'],
  #cat-sites:focus-visible ~ .browse-grid .rail-item[for='cat-sites'],
  #cat-pm:focus-visible ~ .browse-grid .rail-item[for='cat-pm'],
  #cat-seo:focus-visible ~ .browse-grid .rail-item[for='cat-seo'] {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
  }

  /* --- above 44rem: the plan line moves out to its own column ----------- */
  @media (min-width: 44rem) {
    .row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.9rem 1.1rem;
      padding: 0.95rem 1.1rem;
    }

    .row-plan {
      grid-column: auto;
      max-width: 12ch;
      text-align: right;
      border-left: 0;
      border-right: 2px solid var(--amber-line);
      padding-left: 0;
      padding-right: 0.7rem;
      line-height: 1.35;
    }
  }

  /* --- above 54rem: the rail becomes a real vertical rail --------------- */
  @media (min-width: 54rem) {
    .browse-grid {
      grid-template-columns: minmax(0, 15.5rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    .rail {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .rail-item {
      border-color: transparent;
      border-radius: 2px;
      background: transparent;
      padding: 0.8rem 0.9rem;
    }

    .rail-item:last-child {
      grid-column: auto;
    }

    .rail-item:hover {
      background: color-mix(in oklab, white 72%, transparent);
      border-color: var(--line);
    }

    .rail-name {
      font-size: 1rem;
    }

    .panes {
      border-left: 1px solid var(--line);
      padding-left: clamp(1.5rem, 3vw, 2.75rem);
    }
  }

  /* --- above 60rem: heading and lede share a line ----------------------- */
  @media (min-width: 60rem) {
    .browse-head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: end;
    }

    .browse-lede {
      padding-bottom: 0.4rem;
    }
  }

  /* --- above 68rem: lead pick beside its shortlist ---------------------- */
  @media (min-width: 68rem) {
    /* The lead is the narrower column on purpose: portrait card against a
       run of landscape rows, so the two halves read as different kinds of
       thing rather than as a wide cell beside a narrow one. */
    .picks {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.18fr);
      gap: 0.7rem;
      align-items: stretch;
    }

    .lead {
      min-height: 13rem;
      padding: clamp(1.4rem, 2.2vw, 1.9rem);
    }

    /* Pinned to the bottom of the card so the chip lands on one line with
       the shortlist beside it however tall the row grows. */
    .lead-plan {
      margin-top: auto;
    }

    .rest {
      align-content: start;
    }

    /* Two picks is not a lead plus a leftover. The pair splits the width
       evenly and the second pick stands up into a portrait card of its own
       — still flat, still hairlined, but not a lonely strip. */
    .picks[data-count='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .picks[data-count='2'] .rest {
      align-content: stretch;
    }

    /* Three rows — tile, body, then a growing row that holds the plan line
       against the bottom edge, level with the lead card's chip. */
    .picks[data-count='2'] .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      align-items: start;
      height: 100%;
      gap: 0;
      padding: clamp(1.4rem, 2.2vw, 1.9rem);
    }

    .picks[data-count='2'] .row .tile {
      width: 2.6rem;
      height: 2.6rem;
      font-size: 0.95rem;
    }

    .picks[data-count='2'] .row-body {
      margin-top: 1.1rem;
    }

    .picks[data-count='2'] .row-role {
      max-width: 30ch;
    }

    .picks[data-count='2'] .row-plan {
      align-self: end;
      padding-top: 1.25rem;
      max-width: 18ch;
      text-align: left;
      border-right: 0;
      border-left: 2px solid var(--amber-line);
      padding-left: 0.6rem;
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-item,
    .row,
    .lead-name a,
    .row-name a {
      transition: none;
    }
  }

  :global(.lead-rating) {
    margin-top: 0.5rem;
  }

  :global(.row-rating) {
    margin-top: 0.3rem;
    font-size: var(--fs-caption);
  }
</style>
