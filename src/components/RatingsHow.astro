---
/**
 * How ratings work here, in three cells.
 *
 * The big directories bury this; this site puts it on the front page,
 * because the rating layer is only worth anything if a reader believes it.
 * Three cells sharing one hairline, each a plain claim, and the one control
 * on the section is the thing the claims are about: rate something.
 */
import Button from './Button.astro';

interface Props {
  heading?: string;
}

const { heading = 'How the ratings work' } = Astro.props;

const points = [
  {
    title: 'Readers rate. Editors pick.',
    body: 'The order of every shortlist is an editorial decision. The stars beside it come from readers, and the two sit side by side so you can see when they disagree.',
  },
  {
    title: 'One click is a rating.',
    body: 'Tap a star on any tool and it counts. Add the parts that matter, ease of use, value, support, and a line about what you would warn someone, if you have a minute.',
  },
  {
    title: 'Vendors cannot touch them.',
    body: 'No vendor can buy a rating, edit one, remove one, or pay to sit higher. The same rule that keeps paid placement off the shortlists keeps it off the stars.',
  },
];
---

<section class="rh" aria-labelledby="ratings-how">
  <div class="wrap">
    <header class="rh-head" data-rise>
      <h2 id="ratings-how" class="rh-h">{heading}</h2>
      <Button href="/rate" variant="solid">Rate a tool you use</Button>
    </header>

    <ol class="rh-cells" data-rise>
      {
        points.map((p) => (
          <li class="rh-cell">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rh {
    padding-block: clamp(2.75rem, 5.5vw, 4.5rem);
    background: var(--surface-alt);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .rh-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .rh-h {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    letter-spacing: -0.036em;
    line-height: 1.02;
  }

  .rh-cells {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .rh-cell {
    background: var(--color-brand-bg);
    padding: clamp(1.15rem, 2.5vw, 1.75rem);
  }

  .rh-cell h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
  }

  .rh-cell p {
    margin-top: 0.6rem;
    max-width: 40ch;
    font-size: var(--fs-small);
    line-height: 1.62;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  @media (min-width: 52rem) {
    .rh-cells {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
