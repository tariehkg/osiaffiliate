---
/**
 * One product on a category listing — the row G2 draws as a card, drawn here
 * as a row in the site's ledger: a shared hairline between rows, no shadow,
 * no radius beyond the tile's.
 *
 * Reads, left to right on a wide screen: the tile and rank; the name, vendor
 * and rating line; the one-sentence tagline and the best-for / skip-if chips;
 * the pricing shape; the actions. Everything a reader needs to decide whether
 * to open the product page, and a one-click rating so a vote is never more
 * than one click away.
 *
 * The data attributes (`data-pricing`, `data-segments`, `data-rating`) are
 * what FilterRail's script filters and sorts on.
 */
import Button from './Button.astro';
import RatingBadge from './RatingBadge.astro';
import RateWidget from './RateWidget.astro';
import type { Pick, Category } from './data';
import { pickDetail, comparePicks } from './picks-detail';
import { productContent, pricingLabel } from './product-content';
import { getRating } from './ratings';

interface Props {
  category: Category;
  pick: Pick;
  /** 1-based editorial position. */
  rank: number;
}

const { category, pick, rank } = Astro.props;
const detail = pickDetail[pick.slug];
const content = productContent[pick.slug];
const rating = getRating(pick.slug);
const path = `${category.hub}/${pick.slug}`;
const compared = (comparePicks[category.id] ?? []).includes(pick.slug);
---

<article
  class="pc"
  id={pick.slug}
  data-product
  data-rank={rank}
  data-rating={rating.average}
  data-count={rating.count}
  data-pricing={content?.pricing ?? ''}
  data-segments={(content?.segments ?? []).join(' ')}
>
  <div class="pc-id">
    <span class="pc-tile" aria-hidden="true">{pick.monogram}</span>
    <span class="pc-rank">{rank}</span>
  </div>

  <div class="pc-main">
    <div class="pc-head">
      <div>
        <h3 class="pc-name">
          <a href={path}>{pick.name}</a>
        </h3>
        {content && <p class="pc-vendor">by {content.vendor}</p>}
      </div>
      <RatingBadge slug={pick.slug} href={`${path}#ratings`} class="pc-rating" />
    </div>

    <p class="pc-tag">{content?.tagline ?? pick.role}</p>

    {
      content && (
        <dl class="pc-chips">
          <div class="pc-chipset">
            <dt>Best for</dt>
            {content.bestFor.map((c) => (
              <dd class="chip chip-yes">{c}</dd>
            ))}
          </div>
          <div class="pc-chipset">
            <dt>Skip if</dt>
            {content.skipIf.map((c) => (
              <dd class="chip chip-no">{c}</dd>
            ))}
          </div>
        </dl>
      )
    }

    <p class="pc-plan">
      {content && <b>{pricingLabel[content.pricing]}.</b>} {pick.plan}
    </p>
  </div>

  <div class="pc-acts">
    <Button href={detail.url} variant="solid" rel="nofollow noopener sponsored">
      {detail.urlLabel}
    </Button>
    <a href={path} class="pill pill-line">Read the full review</a>
    <RateWidget slug={pick.slug} name={pick.name} href={path} compact />
    {
      category.comparison && compared && (
        <a href={category.comparison.href} class="tlink pc-cmp">
          Compared: {category.comparison.label}
        </a>
      )
    }
  </div>
</article>

<style>
  .pc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'id main'
      'acts acts';
    gap: 1rem 1.1rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
    border-top: 1px solid var(--line);
  }

  .pc.is-hidden {
    display: none;
  }

  .pc-id {
    grid-area: id;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  .pc-tile {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 8px;
    background: var(--color-brand-secondary);
    color: white;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* The editorial position. Numbered because the list is a ranking. */
  .pc-rank {
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-primary);
  }

  .pc-main {
    grid-area: main;
    min-width: 0;
  }

  .pc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
  }

  .pc-name {
    font-size: var(--fs-h3);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .pc-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .pc-name a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  .pc-vendor {
    margin-top: 0.15rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  .pc-tag {
    margin-top: 0.75rem;
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-brand-text) 82%, transparent);
  }

  .pc-chips {
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.45rem;
  }

  .pc-chipset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .pc-chipset dt {
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    min-width: 4.25rem;
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
  }

  .pc-chipset dd {
    margin: 0;
  }

  .chip {
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    line-height: 1.35;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  /* Best-for is cobalt-tinted, skip-if is drawn as a hairline outline: the
     positive is filled, the caveat is a line. Colour is not the only cue. */
  .chip-yes {
    background: var(--tint);
    border-color: color-mix(in oklab, var(--color-brand-primary) 22%, transparent);
    color: var(--color-primary-deep);
  }

  .chip-no {
    border-color: var(--line-strong);
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }

  .pc-plan {
    margin-top: 0.9rem;
    font-size: var(--fs-small);
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .pc-plan b {
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    color: var(--color-brand-primary);
  }

  .pc-acts {
    grid-area: acts;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .pc-cmp {
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-brand-muted);
  }

  @media (min-width: 64rem) {
    .pc {
      grid-template-columns: auto minmax(0, 1fr) 13rem;
      grid-template-areas: 'id main acts';
      gap: 1.5rem;
    }

    .pc-acts {
      flex-direction: column;
      align-items: stretch;
      justify-content: start;
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }

    .pc-acts :global(.pill) {
      justify-content: center;
    }
  }
</style>
