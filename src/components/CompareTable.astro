---
/**
 * The head-to-head grid.
 *
 * A real <table> — the content is genuinely tabular and screen readers should
 * get the row and column relationships — drawn in the site's lattice
 * language: one hairline shared between every cell, no shadows, no radius.
 *
 * Below 52rem it re-lays itself as one block per dimension, with each cell
 * naming its own tool from `data-tool`, so nothing has to scroll sideways on
 * a phone.
 */
interface Row {
  /** What is being compared — the row header. */
  dim: string;
  a: string;
  b: string;
}

interface Side {
  name: string;
  monogram: string;
}

interface Props {
  a: Side;
  b: Side;
  rows: Row[];
  caption: string;
  /** Section heading rendered above the table. */
  title?: string;
  /** One paragraph framing what the table is for. */
  lede?: string;
}

const { a, b, rows, caption, title, lede } = Astro.props;
---

<section class="ct" aria-labelledby={title ? 'differ' : undefined}>
  <div class="wrap">
    {title && <h2 id="differ">{title}</h2>}
    {lede && <p class="ct-lede">{lede}</p>}

    <table>
      <caption class="sr">{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="ct-corner">Where they differ</th>
          <th scope="col">
            <span class="mono" aria-hidden="true">{a.monogram}</span>
            {a.name}
          </th>
          <th scope="col">
            <span class="mono" aria-hidden="true">{b.monogram}</span>
            {b.name}
          </th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.dim}</th>
              <td data-tool={a.name}>{r.a}</td>
              <td data-tool={b.name}>{r.b}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .ct {
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  .ct h2 {
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 650;
  }

  .ct-lede {
    margin-top: 0.7rem;
    max-width: 62ch;
    font-size: 0.99rem;
    line-height: 1.65;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  table {
    margin-top: clamp(1.1rem, 2.5vw, 1.75rem);
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--line);
    background: var(--color-brand-bg);
    text-align: left;
  }

  /* Not sticky: the nav is already sticky and gets taller when the category
     chip strip appears, so a pinned table header ends up underneath it. Ten
     rows do not need one. */
  thead th {
    background: var(--color-brand-surface);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    vertical-align: bottom;
    padding: 0.95rem 1.1rem;
    border-bottom: 1px solid var(--line-strong);
    border-left: 1px solid var(--line);
  }

  thead th:first-child {
    border-left: 0;
  }

  .ct-corner {
    font-weight: 500;
    color: var(--color-brand-muted);
    font-size: 0.875rem;
  }

  .mono {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-right: 0.45rem;
    border-radius: 5px;
    background: var(--color-brand-secondary);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    vertical-align: -0.35rem;
  }

  tbody th {
    width: 22%;
    font-family: var(--font-heading);
    font-size: 0.925rem;
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.35;
    background: color-mix(in oklab, var(--color-brand-surface) 55%, transparent);
  }

  tbody th,
  tbody td {
    padding: 1rem 1.1rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    vertical-align: top;
    font-size: 0.93rem;
    line-height: 1.6;
  }

  tbody th {
    border-left: 0;
  }

  tbody td {
    color: color-mix(in oklab, var(--color-brand-text) 86%, transparent);
  }

  tbody tr:first-child th,
  tbody tr:first-child td {
    border-top: 0;
  }

  /* One block per dimension on a phone: the row header becomes the heading,
     and each value says which tool it belongs to. */
  @media (max-width: 52rem) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    /* Matched to the specificity of the `tbody th` width rule above, which
       would otherwise keep the row header at 22% of the block. */
    tbody th,
    tbody td {
      width: auto;
    }

    table {
      border: 0;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    tbody tr {
      border: 1px solid var(--line);
    }

    tbody tr + tr {
      margin-top: 0.75rem;
    }

    tbody th,
    tbody td {
      border-left: 0;
      padding: 0.85rem 1rem;
    }

    tbody th {
      font-size: 1rem;
      background: var(--color-brand-surface);
      border-top: 0;
      border-bottom: 1px solid var(--line);
    }

    tbody td {
      border-top: 0;
    }

    tbody td + td {
      border-top: 1px solid var(--line);
    }

    tbody td::before {
      content: attr(data-tool);
      display: block;
      margin-bottom: 0.2rem;
      font-family: var(--font-heading);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-brand-primary);
    }
  }
</style>
