---
/**
 * The head-to-head grid on a comparison page.
 *
 * A real <table> — the content is genuinely tabular and screen readers should
 * get the row and column relationships — drawn in the site's lattice
 * language: one hairline shared between every cell, no shadows, no radius.
 *
 * Below 52rem it re-lays itself as one block per dimension, with each cell
 * naming its own tool from `data-tool`, so nothing scrolls sideways.
 */
interface Row {
  dim: string;
  a: string;
  b: string;
}

interface Side {
  name: string;
  monogram: string;
  href?: string;
}

interface Props {
  a: Side;
  b: Side;
  rows: Row[];
  caption: string;
  title?: string;
  lede?: string;
  id?: string;
}

const { a, b, rows, caption, title, lede, id = 'differences' } = Astro.props;
---

<section class="ct" id={id} aria-labelledby={title ? `${id}-h` : undefined}>
  {title && <h2 id={`${id}-h`}>{title}</h2>}
  {lede && <p class="ct-lede">{lede}</p>}

  <table class="ct-table" role="table">
    <caption class="sr">{caption}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader"><span class="sr">Dimension</span></th>
        {
          [a, b].map((s) => (
            <th scope="col" role="columnheader">
              <span class="ct-side">
                <span class="mono" aria-hidden="true">{s.monogram}</span>
                {s.href ? <a href={s.href}>{s.name}</a> : s.name}
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        rows.map((r) => (
          <tr role="row">
            <th scope="row" role="rowheader">{r.dim}</th>
            <td role="cell" data-tool={a.name}>{r.a}</td>
            <td role="cell" data-tool={b.name}>{r.b}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  .ct h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    font-weight: 650;
  }

  .ct-lede {
    margin-top: 0.6rem;
    max-width: 62ch;
    font-size: 0.97rem;
    color: color-mix(in oklab, var(--color-brand-text) 76%, transparent);
  }

  .ct-table {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    border: 1px solid var(--line-strong);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .ct-table th,
  .ct-table td {
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .ct-table thead th {
    background: var(--color-brand-surface);
    font-family: var(--font-heading);
    font-weight: 650;
  }

  .ct-table tbody th {
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.01em;
    width: 24%;
    background: color-mix(in oklab, var(--color-brand-surface) 50%, transparent);
  }

  .ct-side {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ct-side a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .ct-side a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  .mono {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 22%;
    background: var(--color-brand-primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (max-width: 52rem) {
    .ct-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .ct-table,
    .ct-table tbody,
    .ct-table tr,
    .ct-table th,
    .ct-table td {
      display: block;
    }

    .ct-table tr {
      border-top: 1px solid var(--line-strong);
    }

    .ct-table tbody th {
      width: auto;
      border: 0;
      padding-bottom: 0.4rem;
    }

    .ct-table td {
      border: 0;
      padding-top: 0.35rem;
    }

    .ct-table td::before {
      content: attr(data-tool);
      display: block;
      margin-bottom: 0.15rem;
      font-family: var(--font-heading);
      font-size: var(--fs-caption);
      font-weight: 650;
      color: var(--color-brand-primary);
    }
  }
</style>
