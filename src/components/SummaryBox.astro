---
import Score from './Score.astro';
import VendorCta from './VendorCta.astro';

/**
 * The review in one box: the score, four lines that say what it is and who
 * should skip it, the verdict, and the vendor button. Sits directly under
 * the intro so a reader in a hurry gets the answer without scrolling.
 */
interface Props {
  name: string;
  score?: number;
  summary: string[];
  verdict?: string;
  url: string;
  urlLabel: string;
  plan: string;
}

const { name, score, summary, verdict, url, urlLabel, plan } = Astro.props;
---

<aside class="sum" aria-label={`${name} in short`}>
  <div class="sum-head">
    <div>
      <p class="sum-h">{name} in short</p>
      <p class="sum-plan">{plan}</p>
    </div>
    {score !== undefined && <Score score={score} size="lg" label="Editor's score" />}
  </div>

  <ul class="sum-list">
    {summary.map((s) => <li>{s}</li>)}
  </ul>

  {verdict && <p class="sum-verdict">{verdict}</p>}

  <div class="sum-actions">
    <VendorCta href={url} label={urlLabel} />
    <a href="#scores" class="tlink">See the full scoring</a>
  </div>
</aside>

<style>
  .sum {
    padding: clamp(1.2rem, 3vw, 1.75rem);
    background: var(--color-brand-surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--color-brand-primary);
    border-radius: 3px;
  }

  .sum-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .sum-h {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .sum-plan {
    margin-top: 0.25rem;
    font-size: var(--fs-caption);
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
  }

  .sum-list {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .sum-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .sum-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 3px;
    height: 0.85em;
    border-radius: 2px;
    background: var(--color-brand-primary);
  }

  .sum-verdict {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.012em;
  }

  .sum-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.1rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
</style>
