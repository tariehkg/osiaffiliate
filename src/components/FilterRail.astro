---
/**
 * The filter rail beside a category listing, and the sort control above it.
 *
 * Every control is a real checkbox or radio, so the rail is usable with a
 * keyboard and reads correctly to a screen reader. The script filters and
 * reorders the `[data-product]` rows in the sibling listing; with no script
 * the rows simply all show, in editorial order, which is the right fallback.
 *
 * Counts beside each option are computed at build time from the real picks,
 * so an option that would hide everything says (0) before you tick it.
 */
import type { Category } from './data';
import { productContent, pricingLabel, segmentLabel, type PricingModel, type Segment } from './product-content';
import { getRating } from './ratings';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const picks = category.picks;

const pricingOptions = (['free', 'trial', 'paid'] as PricingModel[]).map((p) => ({
  value: p,
  label: pricingLabel[p],
  n: picks.filter((k) => productContent[k.slug]?.pricing === p).length,
}));

const segmentOptions = (['solo', 'small-team', 'agency'] as Segment[]).map((s) => ({
  value: s,
  label: segmentLabel[s],
  n: picks.filter((k) => productContent[k.slug]?.segments.includes(s)).length,
}));

const ratingOptions = [4.5, 4, 3].map((min) => ({
  value: min,
  label: `${min} and up`,
  n: picks.filter((k) => getRating(k.slug).average >= min).length,
}));
---

<aside class="fr" data-filter-rail aria-label="Filter the shortlist">
  <div class="fr-top">
    <h2 class="fr-h">Narrow it down</h2>
    <button type="button" class="fr-clear" data-filter-clear hidden>Clear</button>
  </div>

  <fieldset class="fr-group">
    <legend>How you can start</legend>
    {
      pricingOptions.map((o) => (
        <label class="fr-opt">
          <input type="checkbox" name="pricing" value={o.value} />
          <span>{o.label}</span>
          <span class="fr-n">{o.n}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="fr-group">
    <legend>Built for</legend>
    {
      segmentOptions.map((o) => (
        <label class="fr-opt">
          <input type="checkbox" name="segment" value={o.value} />
          <span>{o.label}</span>
          <span class="fr-n">{o.n}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="fr-group">
    <legend>Reader rating</legend>
    <label class="fr-opt">
      <input type="radio" name="rating" value="0" checked />
      <span>Any</span>
    </label>
    {
      ratingOptions.map((o) => (
        <label class="fr-opt">
          <input type="radio" name="rating" value={o.value} />
          <span>{o.label}</span>
          <span class="fr-n">{o.n}</span>
        </label>
      ))
    }
  </fieldset>

  <p class="fr-note">
    No filter here is paid for. The order you land on is the editorial order; sorting by rating
    reorders by readers.
  </p>
</aside>

<style>
  .fr {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .fr-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .fr-h {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .fr-clear {
    background: none;
    border: 0;
    padding: 0;
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    cursor: pointer;
  }

  .fr-group {
    margin: 0;
    padding: 0.9rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.45rem;
  }

  .fr-group legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
    float: left;
    width: 100%;
  }

  .fr-opt {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-small);
    cursor: pointer;
  }

  .fr-opt input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--color-brand-primary);
  }

  .fr-n {
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-muted);
  }

  .fr-note {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-caption);
    line-height: 1.55;
    color: var(--color-brand-muted);
  }

  /* On a phone the rail becomes a row of groups above the list. */
  @media (max-width: 63.9375rem) {
    .fr {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: 1rem 1.5rem;
    }

    .fr-top,
    .fr-note {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  /**
   * Filtering and sorting for one category listing. The listing is the
   * nearest `[data-listing]` to this rail; rows are its `[data-product]`s.
   */
  for (const rail of document.querySelectorAll<HTMLElement>('[data-filter-rail]')) {
    const scope = rail.closest('[data-catalog]') ?? document;
    const listing = scope.querySelector<HTMLElement>('[data-listing]');
    const sort = scope.querySelector<HTMLSelectElement>('[data-sort]');
    const status = scope.querySelector<HTMLElement>('[data-listing-status]');
    const clear = rail.querySelector<HTMLButtonElement>('[data-filter-clear]');
    if (!listing) continue;

    const rows = Array.from(listing.querySelectorAll<HTMLElement>('[data-product]'));
    const checked = (name: string) =>
      Array.from(rail.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map(
        (i) => i.value,
      );

    const apply = () => {
      const pricing = checked('pricing');
      const segments = checked('segment');
      const minRating = Number(checked('rating')[0] ?? 0);
      let shown = 0;

      for (const row of rows) {
        const okP = !pricing.length || pricing.includes(row.dataset.pricing ?? '');
        const segs = (row.dataset.segments ?? '').split(' ');
        const okS = !segments.length || segments.some((s) => segs.includes(s));
        const okR = Number(row.dataset.rating ?? 0) >= minRating;
        const on = okP && okS && okR;
        row.classList.toggle('is-hidden', !on);
        if (on) shown++;
      }

      const active = pricing.length + segments.length + (minRating > 0 ? 1 : 0);
      if (clear) clear.hidden = active === 0;
      if (status) {
        status.textContent =
          shown === rows.length
            ? `All ${rows.length} picks`
            : shown === 0
              ? 'Nothing matches those filters. Clear one to see the list again.'
              : `${shown} of ${rows.length} picks`;
      }
    };

    const reorder = () => {
      const mode = sort?.value ?? 'editorial';
      const key = (r: HTMLElement) => {
        if (mode === 'rating') return -Number(r.dataset.rating ?? 0);
        if (mode === 'count') return -Number(r.dataset.count ?? 0);
        return Number(r.dataset.rank ?? 0);
      };
      for (const row of [...rows].sort((a, b) => key(a) - key(b))) listing.append(row);
    };

    rail.addEventListener('change', apply);
    sort?.addEventListener('change', reorder);
    clear?.addEventListener('click', () => {
      for (const i of rail.querySelectorAll<HTMLInputElement>('input')) {
        i.checked = i.type === 'radio' && i.value === '0';
      }
      apply();
    });

    apply();
  }
</script>
