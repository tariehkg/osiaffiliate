---
/**
 * The header every non-homepage page opens with.
 *
 * Same vocabulary as the homepage hero — Outfit at display weight, left
 * aligned, a lede capped near 54ch — but a step down in size, so a category
 * hub reads as a section of the site rather than a second front page. No
 * entrance animation: this is always above the fold.
 *
 * `trail` renders a real breadcrumb (used by the comparison pages to point
 * back up to their category hub, which is the silo structure the taxonomy
 * asks for).
 */
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  trail?: Crumb[];
  title: string;
  lede?: string;
  /** Second, quieter paragraph — the honest framing line. */
  note?: string;
  /** 'question' sets the h1 slightly smaller, for the long buyer questions. */
  scale?: 'title' | 'question';
}

const { trail = [], title, lede, note, scale = 'title' } = Astro.props;
---

<header class="ph">
  <div class="wrap">
    {
      trail.length > 0 && (
        <nav class="ph-trail" aria-label="Breadcrumb">
          <ol>
            {trail.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <!-- `before` holds anything that identifies the page ahead of its title,
         such as an author's avatar on their profile. -->
    <slot name="before" />

    <h1 class:list={['ph-h', `is-${scale}`]}>{title}</h1>
    {lede && <p class="ph-lede">{lede}</p>}
    {note && <p class="ph-note">{note}</p>}

    <slot />
  </div>
</header>

<style>
  .ph {
    position: relative;
    padding-block: clamp(2.25rem, 5vw, 3.75rem) clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* The breadcrumb is a route, so it is set as one: separated by slashes,
     sentence case, no chevron glyphs. */
  .ph-trail ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 1.15rem;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
  }

  .ph-trail li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: color-mix(in oklab, var(--color-brand-text) 34%, transparent);
  }

  .ph-trail a {
    color: var(--color-brand-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.24em;
    text-decoration-thickness: 1.5px;
    transition:
      color 0.16s var(--ease),
      text-decoration-color 0.16s var(--ease);
  }

  .ph-trail a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  .ph-h {
    font-weight: 700;
    letter-spacing: -0.038em;
    line-height: 1.04;
  }

  .ph-h.is-title {
    font-size: clamp(2.1rem, 5.6vw, 3.5rem);
    max-width: 24ch;
  }

  /* The buyer questions run long, so they get a smaller size and a wider
     measure rather than four ragged lines of display type. */
  .ph-h.is-question {
    font-size: clamp(1.85rem, 4.4vw, 2.95rem);
    max-width: 30ch;
  }

  .ph-lede {
    margin-top: clamp(1rem, 2vw, 1.35rem);
    max-width: 58ch;
    font-size: clamp(1.01rem, 1.3vw, 1.14rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }

  .ph-note {
    margin-top: 0.85rem;
    max-width: 62ch;
    font-size: 0.94rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 60%, transparent);
  }
</style>
