---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import ArticleFeed from '../components/ArticleFeed.astro';
import Sidebar from '../components/Sidebar.astro';
import BestOfSite from '../components/BestOfSite.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { getArticles, getAuthors } from '../components/articles';
import { SITE_DESCRIPTION } from '../site';

/**
 * The homepage is the feed: the latest reviews, shortlists and comparisons,
 * newest first, beside the sidebar. Then the whole site as a grid of links,
 * then who does the work. Nothing here is written by hand except the hero;
 * everything else is read from the articles collection.
 */
const articles = await getArticles();
const authors = await getAuthors();
const latest = articles.slice(0, 8);
---

<Layout title="OSI Affiliate — business software, reviewed and scored by staff who use it" description={SITE_DESCRIPTION} path="/">
  <main id="main">
    <Hero articles={articles} />
    <CategoryStrip />

    <section class="home">
      <div class="wrap">
        <div class="cols">
          <div class="home-main">
            <ArticleFeed
              title="Latest reviews and guides"
              articles={latest}
              rowAs="h3"
              eagerFirst
              more={{ label: 'All articles', href: '/articles' }}
            />
          </div>
          <Sidebar articles={articles} categories={false} />
        </div>
      </div>
    </section>

    <TrustStrip articles={articles} authors={authors} />
    <BestOfSite articles={articles} />
  </main>
</Layout>

<style>
  .home {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .home-main {
    min-width: 0;
  }
</style>
