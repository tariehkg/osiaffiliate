---
import Redirect from '../../components/Redirect.astro';
import { categoryById } from '../../components/data';
import { getArticles, ofType } from '../../components/articles';

/* The old /<hub>/<product> pages are now reviews at the root. */
export async function getStaticPaths() {
  const reviews = ofType(await getArticles(), 'review');
  return reviews.flatMap((r) => {
    const cat = categoryById(r.data.category);
    if (!cat || !r.data.product) return [];
    return [{ params: { hub: cat.hub.slice(1), slug: r.data.product.id }, props: { to: `/${r.id}` } }];
  });
}

const { to } = Astro.props;
---

<Redirect to={to} />
