---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import ProductHero from '../../components/ProductHero.astro';
import DisclosureNote from '../../components/DisclosureNote.astro';
import SampleNotice from '../../components/SampleNotice.astro';
import RatingSummary from '../../components/RatingSummary.astro';
import RateWidget from '../../components/RateWidget.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import Faq from '../../components/Faq.astro';
import PageTrust from '../../components/PageTrust.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { categories, type Category, type Pick } from '../../components/data';
import { pickDetail, comparePicks } from '../../components/picks-detail';
import { productContent, pricingLabel, segmentLabel } from '../../components/product-content';
import { getReviews, getRating } from '../../components/ratings';
import { breadcrumbLd, softwareApplicationLd, faqPageLd } from '../../components/seo';

/**
 * One page per pick: /crm-software/hubspot-crm and so on. The hub segment
 * comes from the category's own `hub` path, so a product always sits under
 * the category that lists it and the breadcrumb is the real route.
 */
export const getStaticPaths = (async () => {
  return categories.flatMap((category) =>
    category.picks.map((pick, i) => ({
      params: { hub: category.hub.slice(1), slug: pick.slug },
      props: { category, pick, rank: i + 1 },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
  pick: Pick;
  rank: number;
}

const { category, pick, rank } = Astro.props;
const detail = pickDetail[pick.slug];
const content = productContent[pick.slug];
const path = `${category.hub}/${pick.slug}`;
const rating = getRating(pick.slug);
const reviews = getReviews(pick.slug);
const alternatives = category.picks.filter((p) => p.slug !== pick.slug);
const compared = category.comparison && (comparePicks[category.id] ?? []).includes(pick.slug);
const year = new Date().getFullYear();

const title = `${pick.name} review (${year}): pricing, ratings, and who it suits — OSI Affiliate`;
const description = content?.tagline ?? pick.role;

const jsonld = [
  breadcrumbLd([
    { label: 'Home', href: '/' },
    { label: category.name, href: category.hub },
    { label: pick.name, href: path },
  ]),
  softwareApplicationLd({
    slug: pick.slug,
    name: pick.name,
    path,
    description,
    category: category.name,
    vendorUrl: detail.url,
    plan: pick.plan,
  }),
  ...(content?.faqs.length ? [faqPageLd(content.faqs)] : []),
];
---

<Layout title={title} description={description} path={path} type="article" jsonld={jsonld}>
  <SiteNav />
  <main>
    <article>
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={category.hub}>{category.name}</a></li>
          <li><span aria-current="page">{pick.name}</span></li>
        </ol>
      </nav>

      <ProductHero category={category} pick={pick} rank={rank} />

      <div class="wrap">
        <DisclosureNote links />
      </div>

      <!-- Overview -->
      <section class="ps" id="overview" aria-labelledby="overview-h">
        <div class="wrap ps-grid">
          <div class="ps-main">
            <h2 id="overview-h" class="ps-h">Why {pick.name} is on the shortlist</h2>
            {detail.body.map((para) => <p class="ps-p">{para}</p>)}
            <p class="ps-skip">
              <b>Skip it if</b> {detail.skip}
            </p>
          </div>
          <aside class="ps-side">
            <h3 class="ps-side-h">At a glance</h3>
            <dl class="facts">
              {
                content && (
                  <>
                    <div>
                      <dt>Made by</dt>
                      <dd>{content.vendor}</dd>
                    </div>
                    <div>
                      <dt>How you start</dt>
                      <dd>{pricingLabel[content.pricing]}</dd>
                    </div>
                    <div>
                      <dt>Built for</dt>
                      <dd>{content.segments.map((s) => segmentLabel[s]).join(', ')}</dd>
                    </div>
                  </>
                )
              }
              <div>
                <dt>Category</dt>
                <dd><a href={category.hub}>{category.name}</a></dd>
              </div>
              <div>
                <dt>Our position</dt>
                <dd>#{rank} of {category.picks.length} picks</dd>
              </div>
              <div>
                <dt>Reader rating</dt>
                <dd><RatingBadge slug={pick.slug} size={13} href="#ratings" /></dd>
              </div>
            </dl>
            <a href={detail.url} class="tlink facts-out" rel="nofollow noopener sponsored">
              {detail.urlLabel}
            </a>
          </aside>
        </div>
      </section>

      <!-- Ratings -->
      <section class="ps ps-alt" id="ratings" aria-labelledby="ratings-h">
        <div class="wrap">
          <h2 id="ratings-h" class="ps-h">What readers say about {pick.name}</h2>
          <p class="ps-lede">
            Ratings come from readers who use it, not from us, and they sit beside our pick
            rather than deciding it. Vendors cannot buy, edit or remove them.
          </p>
          <SampleNotice class="ps-sample" />

          <div class="ratings-grid">
            <RatingSummary slug={pick.slug} name={pick.name} rateHref="#rate" />
            <RateWidget slug={pick.slug} name={pick.name} id="rate" />
          </div>

          <div class="reviews">
            <h3 class="reviews-h">
              Written reviews {rating.count > 0 && reviews.length === 0 && <span>(none yet)</span>}
            </h3>
            {
              reviews.length > 0 ? (
                <ul class="review-list">
                  {reviews.map((r) => (
                    <li class="review">
                      <p class="review-head">
                        <RatingBadge slug={pick.slug} size={13} />
                        <b>{r.title}</b>
                      </p>
                      <p>{r.body}</p>
                      <p class="review-by">
                        {r.author}
                        {r.role && `, ${r.role}`} · {r.date}
                      </p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="reviews-empty">
                  Nobody has written about {pick.name} here yet. The first written review on
                  a page is the one the next hundred readers use, so if you have run it in a
                  real business, the form above is the place.
                </p>
              )
            }
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section class="ps" id="pricing" aria-labelledby="pricing-h">
        <div class="wrap ps-grid">
          <div class="ps-main">
            <h2 id="pricing-h" class="ps-h">How {pick.name} is priced</h2>
            <p class="ps-lede">
              We describe the shape of the pricing rather than quoting a figure, because figures
              go stale within weeks. The number is on the vendor's own page, one click away.
            </p>
            {
              content && (
                <dl class="pricing">
                  <div>
                    <dt>{pricingLabel[content.pricing]}</dt>
                    <dd>{content.freeTier}</dd>
                  </div>
                  <div>
                    <dt>What you pay for</dt>
                    <dd>{content.pricingShape}</dd>
                  </div>
                  <div>
                    <dt>In one line</dt>
                    <dd>{pick.plan}</dd>
                  </div>
                </dl>
              )
            }
            <a href={detail.url} class="pill pill-line pricing-out" rel="nofollow noopener sponsored">
              Check current pricing on {content?.vendor ?? pick.name}
            </a>
          </div>
        </div>
      </section>

      <!-- Fit -->
      <section class="ps ps-alt" id="fit" aria-labelledby="fit-h">
        <div class="wrap">
          <h2 id="fit-h" class="ps-h">Who {pick.name} is for, and who should skip it</h2>
          {
            content && (
              <div class="fit-grid">
                <div class="fit-col">
                  <h3>Best for</h3>
                  <ul>
                    {content.bestFor.map((b) => (
                      <li class="fit-yes">{b}</li>
                    ))}
                  </ul>
                </div>
                <div class="fit-col">
                  <h3>Skip it if</h3>
                  <ul>
                    {content.skipIf.map((b) => (
                      <li class="fit-no">{b}</li>
                    ))}
                  </ul>
                </div>
              </div>
            )
          }
        </div>
      </section>

      <!-- Alternatives -->
      <section class="ps" id="alternatives" aria-labelledby="alt-h">
        <div class="wrap">
          <h2 id="alt-h" class="ps-h">Alternatives to {pick.name}</h2>
          <p class="ps-lede">
            The other {alternatives.length === 1 ? 'pick' : 'picks'} on our {category.short} shortlist,
            each with its own reason to be there.
          </p>
          <ul class="alts">
            {
              alternatives.map((a) => (
                <li class="alt">
                  <span class="alt-tile" aria-hidden="true">
                    {a.monogram}
                  </span>
                  <div class="alt-body">
                    <h3>
                      <a href={`${category.hub}/${a.slug}`}>{a.name}</a>
                    </h3>
                    <p>{productContent[a.slug]?.tagline ?? a.role}</p>
                    <RatingBadge slug={a.slug} size={13} />
                  </div>
                </li>
              ))
            }
          </ul>
          {
            compared && category.comparison && (
              <p class="alt-cmp">
                Torn between two of them? Read <a href={category.comparison.href} class="tlink">{category.comparison.label}</a>.
              </p>
            )
          }
        </div>
      </section>

      {content?.faqs.length ? <Faq faqs={content.faqs} title={`${pick.name} questions people ask`} /> : null}

      <PageTrust
        title="What this page is, and what it is not"
        body={`This entry is desk research: ${pick.name}'s own pricing and documentation read on the day this page was written, and our editorial judgement of who it suits. The reader ratings are separate from that judgement and do not change our position. We have not run every tool here in a live business for a year, so treat the day-to-day claims as informed reading rather than a field test.`}
      />
    </article>
  </main>
  <SiteFooter />
</Layout>

<style>
  .crumbs {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: color-mix(in oklab, var(--color-brand-text) 34%, transparent);
  }

  .crumbs a {
    color: var(--color-brand-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.24em;
  }

  .crumbs a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  .crumbs span {
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  /* ---- Sections --------------------------------------------------------- */
  .ps {
    padding-block: clamp(2.25rem, 5vw, 3.75rem);
  }

  .ps-alt {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .ps-h {
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 650;
    max-width: 26ch;
  }

  .ps-lede {
    margin-top: 0.7rem;
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  :global(.ps-sample) {
    margin-top: 1rem;
  }

  .ps-grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .ps-p {
    margin-top: 1rem;
    max-width: 66ch;
    font-size: var(--fs-body);
    line-height: 1.68;
    color: color-mix(in oklab, var(--color-brand-text) 88%, transparent);
  }

  .ps-skip {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    max-width: 66ch;
    border-top: 1px solid var(--line-strong);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  .ps-skip b {
    font-weight: 650;
  }

  .ps-side-h {
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    color: var(--color-brand-muted);
  }

  .facts {
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--line);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-small);
  }

  .facts dt {
    color: color-mix(in oklab, var(--color-brand-text) 62%, transparent);
  }

  .facts dd {
    margin: 0;
    font-weight: var(--fw-medium);
  }

  .facts-out {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  /* ---- Ratings ---------------------------------------------------------- */
  .ratings-grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .reviews {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .reviews-h {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .reviews-h span {
    font-weight: var(--fw-regular);
    color: var(--color-brand-muted);
  }

  .reviews-empty {
    margin-top: 0.75rem;
    max-width: 62ch;
    padding: 1rem 1.15rem;
    border: 1px dashed var(--line-strong);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .review-list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .review {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .review-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
  }

  .review-by {
    margin-top: 0.4rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  /* ---- Pricing ---------------------------------------------------------- */
  .pricing {
    margin: 1.25rem 0 0;
    max-width: 66ch;
    border-top: 1px solid var(--line);
  }

  .pricing > div {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .pricing dt {
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    color: var(--color-brand-primary);
  }

  .pricing dd {
    margin: 0.3rem 0 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-brand-text) 84%, transparent);
  }

  .pricing-out {
    margin-top: 1.25rem;
  }

  /* ---- Fit -------------------------------------------------------------- */
  .fit-grid {
    display: grid;
    gap: 1px;
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
    background: var(--line);
    border: 1px solid var(--line);
  }

  .fit-col {
    background: var(--color-brand-bg);
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
  }

  .fit-col h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .fit-col ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .fit-col li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .fit-col li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-heading);
    font-weight: var(--fw-bold);
  }

  .fit-yes::before {
    content: '+';
    color: var(--color-brand-primary);
  }

  .fit-no::before {
    content: '–';
    color: var(--amber-deep);
  }

  /* ---- Alternatives ----------------------------------------------------- */
  .alts {
    margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .alt {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    background: var(--color-brand-bg);
    padding: 1.1rem 1.15rem;
    transition: background-color 0.16s var(--ease);
  }

  .alt:hover {
    background: var(--tint);
  }

  .alt-tile {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 7px;
    background: var(--color-brand-secondary);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .alt-body h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .alt-body h3 a {
    text-decoration: none;
  }

  .alt-body h3 a:hover {
    color: var(--color-brand-primary);
  }

  .alt-body p {
    margin: 0.3rem 0 0.5rem;
    max-width: 60ch;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  .alt-cmp {
    margin-top: 1rem;
    font-size: var(--fs-small);
  }

  @media (min-width: 60rem) {
    .ps-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .ps-side {
      padding-left: clamp(1.5rem, 4vw, 3rem);
      border-left: 1px solid var(--line);
    }

    .ratings-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }

    .fit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
