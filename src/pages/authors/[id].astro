---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CategoryStrip from '../../components/CategoryStrip.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleFeed from '../../components/ArticleFeed.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getArticles, getAuthors, authorUrl } from '../../components/articles';
import { breadcrumbLd } from '../../components/seo';

export async function getStaticPaths() {
  const authors = await getAuthors();
  const articles = await getArticles();
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author, articles, mine: articles.filter((a) => a.data.author.id === author.id) },
  }));
}

const { author, articles, mine } = Astro.props;
const path = authorUrl(author.id);
---

<Layout
  title={`${author.data.name} — OSI Affiliate`}
  description={author.data.bio}
  path={path}
  noindex={author.data.placeholder}
  jsonld={[breadcrumbLd([{ label: 'Home', href: '/' }, { label: 'The reviews desk', href: '/authors' }, { label: author.data.name, href: path }])]}
>
  <CategoryStrip />
  <main id="main">
    <PageHead
      trail={[{ label: 'Home', href: '/' }, { label: 'The reviews desk', href: '/authors' }]}
      title={author.data.name}
      lede={author.data.bio}
      note={author.data.role}
    >
      <Image slot="before" src={author.data.avatar} alt="" width={96} height={96} quality={80} class:list={['ap-avatar', author.data.placeholder && 'is-placeholder']} />
    </PageHead>

    <section class="ap">
      <div class="wrap">
        <div class="cols">
          <div class="ap-main">
            {
              mine.length > 0 ? (
                <ArticleFeed title={`Articles by ${author.data.name}`} articles={mine} rowAs="h2" />
              ) : (
                <p class="ap-empty">Nothing published under this name yet.</p>
              )
            }
          </div>
          <Sidebar articles={articles} />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(.ap-avatar) {
    width: 4.5rem;
    height: 4.5rem;
    padding: 0.55rem;
    margin-bottom: 1.1rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: var(--color-brand-bg);
  }

  :global(.ap-avatar.is-placeholder) {
    border-style: dashed;
  }

  .ap {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .ap-main {
    min-width: 0;
  }

  .ap-empty {
    font-size: var(--fs-body);
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }
</style>
