---
import Layout from '../../layouts/Layout.astro';
import CategoryStrip from '../../components/CategoryStrip.astro';
import PageHead from '../../components/PageHead.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getArticles, getAuthors } from '../../components/articles';

const authors = await getAuthors();
const articles = await getArticles();
const count = (id: string) => articles.filter((a) => a.data.author.id === id).length;
---

<Layout
  title="The reviews desk — OSI Affiliate"
  description="The staff who review, score and compare the software on this site."
  path="/authors"
>
  <CategoryStrip />
  <main id="main">
    <PageHead
      title="The reviews desk"
      lede="Everyone who writes here signs up for the tool, runs it against the same five criteria and puts their name on the result."
    />
    <section class="au">
      <div class="wrap">
        <div class="au-list">
          {authors.map((a) => <AuthorCard author={a} variant="row" articleCount={count(a.id)} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .au {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .au-list {
    max-width: 52rem;
    border-bottom: 1px solid var(--line);
  }
</style>
