---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import PageHead from '../components/PageHead.astro';
import RateWidget from '../components/RateWidget.astro';
import RatingBadge from '../components/RatingBadge.astro';
import SampleNotice from '../components/SampleNotice.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { categories } from '../components/data';
import { breadcrumbLd } from '../components/seo';

/**
 * The front door for rating. Every pick on the site, grouped by category,
 * each with a one-click star row that carries the vote to the product page.
 * A reader who knows what they use should be able to land here, find it,
 * and rate it in two clicks; the search box narrows the list as you type.
 */
const total = categories.reduce((n, c) => n + c.picks.length, 0);
const jsonld = [breadcrumbLd([{ label: 'Home', href: '/' }, { label: 'Rate a tool', href: '/rate' }])];
---

<Layout
  title="Rate the software you use — OSI Affiliate"
  description={`Rate any of the ${total} tools on our shortlists in one click. Reader ratings sit beside our editorial pick and vendors cannot buy, edit or remove them.`}
  path="/rate"
  jsonld={jsonld}
>
  <SiteNav />
  <main>
    <PageHead
      trail={[{ label: 'Home', href: '/' }]}
      title="Rate what you use"
      lede={`One click on a star is a rating. Every one of the ${total} tools on our shortlists is below; find yours, tap a star, and add a line or two if you have a minute.`}
      note="Ratings come from readers, sit beside our editorial pick without changing it, and cannot be bought, edited or removed by a vendor."
    >
      <SampleNotice class="rate-sample" />
    </PageHead>

    <section class="rate" aria-label="Every tool, by category">
      <div class="wrap">
        <label class="rate-find">
          <span class="sr">Find a tool</span>
          <input type="search" placeholder="Type a tool or category, e.g. Notion" data-rate-find autocomplete="off" />
        </label>

        {
          categories.map((c) => (
            <section class="rate-cat" data-rate-cat aria-labelledby={`rate-${c.id}`}>
              <h2 id={`rate-${c.id}`} class="rate-cat-h">
                <a href={c.hub}>{c.name}</a>
              </h2>
              <ul class="rate-list">
                {c.picks.map((p) => (
                  <li class="rate-row" data-rate-row data-name={`${p.name} ${c.name}`.toLowerCase()}>
                    <span class="rate-tile" aria-hidden="true">
                      {p.monogram}
                    </span>
                    <div class="rate-body">
                      <h3 class="rate-name">
                        <a href={`${c.hub}/${p.slug}`}>{p.name}</a>
                      </h3>
                      <RatingBadge slug={p.slug} size={13} href={`${c.hub}/${p.slug}#ratings`} />
                    </div>
                    <RateWidget slug={p.slug} name={p.name} href={`${c.hub}/${p.slug}`} compact />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        <p class="rate-none" data-rate-none hidden>
          Nothing on our shortlists matches that. If it should be here, <a href="/contact" class="tlink">tell us</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  :global(.rate-sample) {
    margin-top: 1rem;
  }

  .rate {
    padding-block: clamp(0.5rem, 2vw, 1rem) clamp(3rem, 6vw, 5rem);
  }

  .rate-find input {
    width: 100%;
    max-width: 30rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--color-brand-bg);
    font-size: var(--fs-body);
  }

  .rate-find input:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 1px;
  }

  .rate-cat {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .rate-cat.is-hidden {
    display: none;
  }

  .rate-cat-h {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .rate-cat-h a {
    text-decoration: none;
  }

  .rate-cat-h a:hover {
    color: var(--color-brand-primary);
  }

  .rate-list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .rate-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'tile body'
      'vote vote';
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .rate-row.is-hidden {
    display: none;
  }

  .rate-tile {
    grid-area: tile;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 7px;
    background: var(--color-brand-secondary);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .rate-body {
    grid-area: body;
    min-width: 0;
  }

  .rate-name {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .rate-name a {
    text-decoration: none;
  }

  .rate-name a:hover {
    color: var(--color-brand-primary);
  }

  .rate-row > :global(.rw-compact) {
    grid-area: vote;
  }

  .rate-none {
    margin-top: 2rem;
    font-size: var(--fs-body);
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
  }

  @media (min-width: 44rem) {
    .rate-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'tile body vote';
    }
  }
</style>

<script>
  const q = document.querySelector<HTMLInputElement>('[data-rate-find]');
  const cats = Array.from(document.querySelectorAll<HTMLElement>('[data-rate-cat]'));
  const none = document.querySelector<HTMLElement>('[data-rate-none]');

  q?.addEventListener('input', () => {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const cat of cats) {
      let inCat = 0;
      for (const row of cat.querySelectorAll<HTMLElement>('[data-rate-row]')) {
        const on = !term || (row.dataset.name ?? '').includes(term);
        row.classList.toggle('is-hidden', !on);
        if (on) inCat++;
      }
      cat.classList.toggle('is-hidden', inCat === 0);
      shown += inCat;
    }
    if (none) none.hidden = shown > 0;
  });
</script>
