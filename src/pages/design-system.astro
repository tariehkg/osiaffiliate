---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import PageHead from '../components/PageHead.astro';
import Mark from '../components/Mark.astro';
import Button from '../components/Button.astro';
import VendorCta from '../components/VendorCta.astro';
import Score from '../components/Score.astro';
import ScoreBars from '../components/ScoreBars.astro';
import ProsCons from '../components/ProsCons.astro';
import FitList from '../components/FitList.astro';
import SummaryBox from '../components/SummaryBox.astro';
import ArticleThumb from '../components/ArticleThumb.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ArticleFeed from '../components/ArticleFeed.astro';
import ReviewCard from '../components/ReviewCard.astro';
import QuickPicks from '../components/QuickPicks.astro';
import PickTable from '../components/PickTable.astro';
import CompareTable from '../components/CompareTable.astro';
import HelpBox from '../components/HelpBox.astro';
import Toc from '../components/Toc.astro';
import Pagination from '../components/Pagination.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Byline from '../components/Byline.astro';
import DisclosureNote from '../components/DisclosureNote.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import Faq from '../components/Faq.astro';
import SearchBox from '../components/SearchBox.astro';
import Prose from '../components/Prose.astro';
import { getArticles, byId, ofType, typeLabel } from '../components/articles';

/**
 * The component inventory. Every reusable component in src/components/ is
 * listed here with its file path, and rendered with real data from the
 * articles collection wherever it can be rendered in isolation. Keep this
 * page in step with the folder: add, rename or remove a component here in
 * the same change.
 */
const articles = await getArticles();
const review = ofType(articles, 'review')[0];
const best = ofType(articles, 'best')[0];
const comparison = ofType(articles, 'comparison')[0];
const guide = ofType(articles, 'guide')[0];
const author = review ? await getEntry(review.data.author) : undefined;
const p = review?.data.product;
const picks = (best?.data.picks ?? [])
  .map((k) => ({ review: byId(articles, k.review), bestFor: k.bestFor }))
  .filter((k): k is { review: NonNullable<typeof k.review>; bestFor: string } => Boolean(k.review));
const sideA = comparison?.data.compare ? byId(articles, comparison.data.compare.a) : undefined;
const sideB = comparison?.data.compare ? byId(articles, comparison.data.compare.b) : undefined;

const sections = [
  { name: 'Layout', file: 'src/layouts/Layout.astro', note: 'Document shell. Renders SiteNav and SiteFooter, the meta tags, JSON-LD and the search index JSON on every page.' },
  { name: 'SiteNav', file: 'src/components/SiteNav.astro', note: 'Header with the four panel menus, compact search and the "How we test" action; folds into a drawer under 64rem. In the Layout, so it is on this page.' },
  { name: 'SiteFooter', file: 'src/components/SiteFooter.astro', note: 'Footer site map read from the collection, disclosure and sign-off. In the Layout.' },
  { name: 'Hero', file: 'src/components/Hero.astro', note: 'Homepage opening: the phrase, the search field, the three counts and the mark. Homepage only.' },
  { name: 'BestOfSite', file: 'src/components/BestOfSite.astro', note: '"Start here": one column of links per category plus guides. Homepage only.' },
  { name: 'TrustStrip', file: 'src/components/TrustStrip.astro', note: 'The inverted staff-and-counts section. Homepage only.' },
  { name: 'Sidebar', file: 'src/components/Sidebar.astro', note: 'The right column: search, HelpBox, top-scored tools, categories, guides, plus a slot. Article pages, hubs and indexes.' },
  { name: 'ArticlePage', file: 'src/components/ArticlePage.astro', note: 'The template every article renders through, ordering the structured blocks per article type.' },
  { name: 'CategoryHubPage', file: 'src/components/CategoryHubPage.astro', note: 'The template each of the five hub pages passes its category id to.' },
  { name: 'PageHead', file: 'src/components/PageHead.astro', note: 'Title, lede, note and optional breadcrumb for the site-wide pages. It heads this page.' },
  { name: 'Doc', file: 'src/components/Doc.astro', note: 'Reading column for site-wide pages: page wrap plus Prose at 44rem.' },
  { name: 'Redirect', file: 'src/components/Redirect.astro', note: 'A forwarding page for old URLs: canonical, meta refresh, one link.' },
];
---

<Layout title="Design system — OSI Affiliate" description="Component inventory for the OSI Affiliate site." noindex>
  <CategoryStrip />
  <main id="main" class="ds">
    <PageHead
      title="Design system"
      lede="Every reusable component, with its file path, rendered with real data from the articles collection. Check here before building anything new."
    />

    <div class="wrap ds-body">
      <section class="ds-sec">
        <h2>Page-level components</h2>
        <p class="ds-note">These compose whole pages or regions and are described rather than rendered twice.</p>
        <ul class="ds-list">
          {sections.map((s) => (
            <li>
              <b>{s.name}</b> <code>{s.file}</code>
              <span>{s.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="ds-sec">
        <h2>Mark</h2>
        <code>src/components/Mark.astro</code>
        <div class="ds-row">
          <Mark size={26} wordmark />
          <Mark size={48} />
          <span class="ds-navy"><Mark size={26} tone="light" wordmark /></span>
        </div>
      </section>

      <section class="ds-sec">
        <h2>Button and VendorCta</h2>
        <code>src/components/Button.astro</code> <code>src/components/VendorCta.astro</code>
        <div class="ds-row">
          <Button variant="solid">Solid</Button>
          <Button variant="line">Line</Button>
          <span class="ds-navy"><Button variant="invert">Invert</Button></span>
          <VendorCta href="https://example.com" label="Visit example.com" />
          <VendorCta href="https://example.com" label="Visit example.com" variant="line" />
        </div>
      </section>

      <section class="ds-sec">
        <h2>Score</h2>
        <code>src/components/Score.astro</code>
        <div class="ds-row">
          <Score score={4.4} size="sm" />
          <Score score={4.4} size="md" />
          <Score score={4.4} size="lg" label="Editor's score" />
        </div>
      </section>

      <section class="ds-sec">
        <h2>CategoryStrip and SearchBox</h2>
        <code>src/components/CategoryStrip.astro</code> <code>src/components/SearchBox.astro</code>
        <p class="ds-note">The strip is under the header on this page. Search in three sizes:</p>
        <div class="ds-stack">
          <SearchBox variant="hero" id="ds-search-hero" />
          <SearchBox variant="nav" id="ds-search-nav" placeholder="Search…" />
          <SearchBox variant="side" id="ds-search-side" />
        </div>
      </section>

      <section class="ds-sec">
        <h2>DisclosureNote, ProvisionalNote, HelpBox</h2>
        <code>src/components/DisclosureNote.astro</code> <code>src/components/ProvisionalNote.astro</code> <code>src/components/HelpBox.astro</code>
        <div class="ds-stack">
          <DisclosureNote links />
          <ProvisionalNote />
          <div class="ds-narrow"><HelpBox /></div>
        </div>
      </section>

      {review && p && author && (
        <>
          <section class="ds-sec">
            <h2>ArticleThumb</h2>
            <code>src/components/ArticleThumb.astro</code>
            <p class="ds-note">One tile per article type, on the category's tone. A guide with a photo shows the photo.</p>
            <div class="ds-thumbs">
              {[review, best, comparison, ofType(articles, 'alternatives')[0], ofType(articles, 'pricing')[0], guide].filter(Boolean).map((a) => (
                <div>
                  <ArticleThumb article={a!} size="md" />
                  <small>{typeLabel[a!.data.type]}</small>
                </div>
              ))}
            </div>
          </section>

          <section class="ds-sec">
            <h2>Byline and AuthorCard</h2>
            <code>src/components/Byline.astro</code> <code>src/components/AuthorCard.astro</code>
            <div class="ds-stack">
              <Byline author={author} published={review.data.pubDate} minutes={6} />
              <AuthorCard author={author} variant="panel" />
              <AuthorCard author={author} variant="row" articleCount={3} as="h3" />
            </div>
          </section>

          <section class="ds-sec">
            <h2>ArticleRow, ArticleFeed, ReviewCard</h2>
            <code>src/components/ArticleRow.astro</code> <code>src/components/ArticleFeed.astro</code> <code>src/components/ReviewCard.astro</code>
            <div class="ds-stack">
              <ArticleRow article={review} />
              <ArticleRow article={best} compact />
              <ArticleFeed title="A feed" articles={articles.slice(0, 2)} more={{ label: 'All articles', href: '/articles' }} />
              <div class="ds-narrow"><ReviewCard review={review} /></div>
            </div>
          </section>

          <section class="ds-sec">
            <h2>SummaryBox, ProsCons, FitList, ScoreBars</h2>
            <code>src/components/SummaryBox.astro</code> <code>src/components/ProsCons.astro</code> <code>src/components/FitList.astro</code> <code>src/components/ScoreBars.astro</code>
            <div class="ds-stack">
              <SummaryBox name={p.name} score={p.score} summary={p.summary} verdict={p.verdict} url={p.url} urlLabel={p.urlLabel} plan={p.plan} />
              <ProsCons name={p.name} pros={p.pros} cons={p.cons} id="ds-pc" />
              <FitList name={p.name} bestFor={p.bestFor} notFor={p.notFor} id="ds-fit" />
              {p.score !== undefined && <ScoreBars name={p.name} criteria={p.criteria} overall={p.score} id="scores" />}
            </div>
          </section>
        </>
      )}

      {picks.length > 0 && (
        <section class="ds-sec">
          <h2>QuickPicks and PickTable</h2>
          <code>src/components/QuickPicks.astro</code> <code>src/components/PickTable.astro</code>
          <div class="ds-stack">
            <QuickPicks picks={picks} />
            <PickTable picks={picks} id="ds-overview" />
          </div>
        </section>
      )}

      {comparison?.data.compare && sideA?.data.product && sideB?.data.product && (
        <section class="ds-sec">
          <h2>CompareTable</h2>
          <code>src/components/CompareTable.astro</code>
          <CompareTable
            a={{ name: sideA.data.product.name, monogram: sideA.data.product.monogram }}
            b={{ name: sideB.data.product.name, monogram: sideB.data.product.monogram }}
            rows={comparison.data.compare.rows.slice(0, 3)}
            caption="Sample"
            id="ds-ct"
          />
        </section>
      )}

      <section class="ds-sec">
        <h2>Toc, Pagination, Faq</h2>
        <code>src/components/Toc.astro</code> <code>src/components/Pagination.astro</code> <code>src/components/Faq.astro</code>
        <div class="ds-stack">
          <div class="ds-narrow"><Toc items={[{ text: 'Pros and cons', slug: 'ds-pc' }, { text: 'Is it for you?', slug: 'ds-fit' }, { text: 'How we scored it', slug: 'scores' }]} /></div>
          <Pagination page={{ currentPage: 2, lastPage: 4, url: { prev: '#', next: '#' } }} hrefFor={() => '#'} />
          <div class="ds-faq"><Faq id="ds-faq" faqs={[{ q: 'A question?', a: 'An answer, two to four sentences long.' }, { q: 'Another question?', a: 'Another answer.' }]} /></div>
        </div>
      </section>

      <section class="ds-sec">
        <h2>Prose</h2>
        <code>src/components/Prose.astro</code>
        <Prose>
          <h2>A heading</h2>
          <p>Body copy at the reading size, with a <a href="#">link</a> and <strong>emphasis</strong>.</p>
          <ul><li>An unordered item with the amber marker</li><li>Another</li></ul>
          <ol><li>A numbered step</li><li>The next step</li></ol>
          <blockquote><p>A pulled sentence.</p></blockquote>
        </Prose>
      </section>
    </div>
  </main>
</Layout>

<style>
  .ds-body {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 60rem;
  }

  .ds-sec {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .ds-sec h2 {
    font-size: 1.35rem;
    font-weight: 650;
  }

  .ds-sec > code {
    display: inline-block;
    margin: 0.4rem 0.4rem 0 0;
    font-size: 0.82rem;
    padding: 0.1rem 0.4rem;
    background: var(--color-brand-surface);
    border-radius: 3px;
  }

  .ds-note {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .ds-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .ds-list li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.95rem;
  }

  .ds-list code {
    font-size: 0.82rem;
    color: var(--color-brand-muted);
  }

  .ds-list span {
    color: color-mix(in oklab, var(--color-brand-text) 72%, transparent);
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .ds-stack {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .ds-narrow {
    max-width: 19rem;
  }

  .ds-navy {
    display: inline-block;
    padding: 0.75rem 1rem;
    background: var(--color-brand-secondary);
    border-radius: 4px;
  }

  .ds-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .ds-thumbs small {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  .ds-faq :global(.wrap) {
    padding-inline: 0;
  }
</style>
