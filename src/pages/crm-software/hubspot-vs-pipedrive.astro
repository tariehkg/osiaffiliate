---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import PageHead from '../../components/PageHead.astro';
import DisclosureNote from '../../components/DisclosureNote.astro';
import CompareSides from '../../components/CompareSides.astro';
import CompareTable from '../../components/CompareTable.astro';
import Verdict from '../../components/Verdict.astro';
import PageTrust from '../../components/PageTrust.astro';
import CompareFoot from '../../components/CompareFoot.astro';
import SiteFooter from '../../components/SiteFooter.astro';

/**
 * Dimensions chosen because they are the ones that actually change the
 * decision between these two, and because each can be stated qualitatively
 * from the vendors' own documentation. No seat prices, contact tiers or
 * percentages: those move, and we have not verified every tier.
 */
const rows = [
  {
    dim: 'What it is built around',
    a: 'A contact record that marketing, sales and support all work from. The pipeline is one view onto it.',
    b: 'The pipeline itself. You open on stages and deals, and the tool keeps asking what the next action is.',
  },
  {
    dim: 'Free tier',
    a: 'A genuinely usable free CRM: contacts, companies, deals, email tracking and forms without a card.',
    b: 'No lasting free plan. A trial, then paid from the first month.',
  },
  {
    dim: 'How you pay',
    a: 'Tiered hubs plus seats, with marketing plans also scaling by contact count. The bill has more than one axis.',
    b: 'Per seat, per month, by plan tier. Easier to predict a year ahead.',
  },
  {
    dim: 'Day-to-day for a rep',
    a: 'More surface to learn, more places a deal can live. Powerful once configured; slower to feel obvious.',
    b: 'Fewer decisions. Drag the deal, log the call, see what is overdue. The reason reps actually keep it current.',
  },
  {
    dim: 'Marketing and service breadth',
    a: 'The point of the product. Email campaigns, landing pages, chat, help desk and reporting attach to the same contact.',
    b: 'Sales-focused by design. Marketing email and support live in other tools you integrate.',
  },
  {
    dim: 'Automation',
    a: 'Deep, and reaches across marketing and service as well as sales — but the good parts sit on higher tiers.',
    b: 'Solid sales automation: stage triggers, activity reminders, sequences. Narrower scope, less to configure.',
  },
  {
    dim: 'Reporting',
    a: 'Broader: campaign attribution and lifecycle reporting alongside sales numbers, again tier-dependent.',
    b: 'Sales-shaped: forecast, conversion by stage, activity volume. Enough for most small teams.',
  },
  {
    dim: 'Where it gets expensive',
    a: 'Upgrading for one feature, because features are bundled into tiers. Contact-tier growth adds cost quietly.',
    b: 'Headcount, and paid add-ons for things like extra automation or documents.',
  },
  {
    dim: 'Leaving later',
    a: 'Harder the longer you stay, because marketing, forms and support content end up inside it too.',
    b: 'Easier. It holds contacts, deals and activities, and exports of those are a normal request.',
  },
];
---

<Layout
  title="HubSpot vs Pipedrive: which CRM to pick — OSI Affiliate"
  description="HubSpot CRM and Pipedrive compared on free tier, pipeline focus, marketing breadth, pricing model and lock-in — with a straight answer about which one to pick."
>
  <SiteNav />
  <main>
    <PageHead
      trail={[
        { label: 'All categories', href: '/' },
        { label: 'CRM & Sales', href: '/crm-software' },
      ]}
      title="HubSpot vs Pipedrive"
      lede="Both are on our CRM shortlist, and they are not really competing for the same job. HubSpot wants to be the record of the customer. Pipedrive wants to be the place a deal moves forward."
      note="Comparison dimensions below are qualitative on purpose: every one is checked against the vendors’ own current documentation, and neither of us has run both in the same live pipeline for a year."
    >
      <DisclosureNote links />
    </PageHead>

    <CompareSides category="crm" slugs={['hubspot-crm', 'pipedrive']} />

    <CompareTable
      title="Where they actually differ"
      lede="Feature-list comparisons make these two look interchangeable, because on paper both store a contact and move a deal. These are the nine things that change the answer."
      caption="HubSpot CRM and Pipedrive compared across nine dimensions"
      a={{ name: 'HubSpot CRM', monogram: 'Hs' }}
      b={{ name: 'Pipedrive', monogram: 'Pd' }}
      rows={rows}
    />

    <Verdict
      calls={[
        {
          name: 'HubSpot CRM',
          who: 'you need to start at zero cost, or you can already picture marketing email and support conversations hanging off the same contact record. Starting here saves you a migration you would otherwise do in year two.',
        },
        {
          name: 'Pipedrive',
          who: 'selling is the job and someone carries a number. You have budget from day one, you want reps working a pipeline rather than learning a platform, and marketing lives somewhere else already.',
        },
      ]}
    >
      <p>
        If you want the short version: <em>pipeline discipline points to Pipedrive, one
        customer record points to HubSpot</em>. Most teams know which of those sentences
        describes them, and that is a better basis for the decision than a feature count.
      </p>
      <p>
        The trap worth naming is the free plan. HubSpot free is the easiest way to get a CRM
        running this week, and it is genuinely good, so plenty of teams end up there by
        default and then discover that the features making HubSpot worth it sit a tier or two
        up. That is fine if breadth was the plan. It is an expensive accident if all you ever
        wanted was a pipeline — in which case paying Pipedrive from month one is the cheaper
        decision over three years, not the dearer one.
      </p>
      <p>
        Both will hold your data well. The difference in how hard they are to leave is real
        though: HubSpot gets stickier the more of your marketing lives inside it, and that is
        worth pricing in while the decision is still cheap to make.
      </p>
    </Verdict>

    <PageTrust
      title="What this comparison does not cover"
      body="We have not run a full sales year in both tools side by side, so treat the day-to-day judgements as informed reading of the products and their documentation rather than a field test. Specific plan prices, seat minimums and contact tiers are deliberately absent because both vendors change them; check each pricing page before you commit. If you have used both in anger and think a row here is wrong, tell us and we will change it."
    />

    <CompareFoot category="crm" slugs={['hubspot-crm', 'pipedrive']} />
  </main>
  <SiteFooter />
</Layout>
