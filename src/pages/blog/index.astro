---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getPublishedPosts } from '../../components/blog';

// Drafts are removed inside getPublishedPosts(); newest first.
const posts = await getPublishedPosts();
---

<Layout
  title="Blog — OSI Affiliate"
  description="Notes on choosing, switching and living with small-business software: when to move off a spreadsheet, how to migrate without losing anything, and what each kind of tool actually fixes."
>
  <SiteNav />
  <main>
    <PageHead
      title="Notes on switching tools"
      lede="The shortlists say what to pick. These posts cover the rest: how to tell you have outgrown what you use now, and how to move without losing anything on the way."
    />

    <section class="blog-list" aria-label="All posts">
      <div class="wrap">
        {
          posts.length > 0 ? (
            <PostList posts={posts} feature label="Earlier posts" />
          ) : (
            <p class="blog-empty">
              Nothing published yet. The <a href="/" class="tlink">shortlists</a> are the best
              place to start in the meantime.
            </p>
          )
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .blog-list {
    padding-block: clamp(0.5rem, 2vw, 1rem) clamp(3rem, 6vw, 5rem);
  }

  .blog-empty {
    max-width: 52ch;
    font-size: var(--fs-body);
    color: color-mix(in oklab, var(--color-brand-text) 74%, transparent);
  }
</style>
