---
import Redirect from '../../components/Redirect.astro';
import { getArticles, ofType } from '../../components/articles';

/* The old /blog/[id] posts are now guides at the root. */
export async function getStaticPaths() {
  const guides = ofType(await getArticles(), 'guide');
  return guides.map((g) => ({ params: { id: g.id }, props: { to: `/${g.id}` } }));
}

const { to } = Astro.props;
---

<Redirect to={to} />
