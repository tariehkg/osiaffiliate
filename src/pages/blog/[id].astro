---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import PageHead from '../../components/PageHead.astro';
import Doc from '../../components/Doc.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { formatDate, getPublishedPosts, readingMinutes, type Post } from '../../components/blog';

/**
 * One page per published post. Drafts never reach getStaticPaths, so a draft
 * has no URL at all — not a hidden page, no page.
 */
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const { featuredImage } = post.data;
---

<Layout title={`${post.data.title} — OSI Affiliate`} description={post.data.description}>
  <SiteNav />
  <main>
    <article>
      <PageHead
        trail={[
          { label: 'Home', href: '/' },
          { label: 'Blog', href: '/blog' },
        ]}
        title={post.data.title}
        lede={post.data.description}
        scale="question"
      >
        <div class="byline">
          {
            author && (
              <Image
                src={author.data.avatar}
                alt={`${author.data.name} avatar`}
                width={40}
                height={40}
                quality={80}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="byline-avatar"
              />
            )
          }
          <div>
            {
              author && (
                <p class="byline-name">
                  <a href={`/authors/${author.id}`}>{author.data.name}</a>
                </p>
              )
            }
            <p class="byline-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {`, ${readingMinutes(post.body)} minute read`}
            </p>
          </div>
        </div>
      </PageHead>

      <figure class="hero wrap">
        <div class="hero-frame">
          <Image
            src={featuredImage.src}
            alt={featuredImage.alt}
            width={1152}
            height={768}
            widths={[640, 960, 1152, 1600, 2304]}
            sizes="(min-width: 78rem) 1152px, 92vw"
            quality={80}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
        {featuredImage.credit && <figcaption>{featuredImage.credit}</figcaption>}
      </figure>

      <Doc>
        <Content />
      </Doc>

      <!-- Outside Doc on purpose: Doc styles every p, ul and h2 inside it as
           prose, and none of this is prose. -->
      <footer class="post-foot wrap">
        <div class="post-foot-col">
          {
            post.data.tags.length > 0 && (
              <ul class="post-tags" aria-label="Topics">
                {post.data.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )
          }
          {author && <AuthorCard author={author} />}
          <p class="post-back">
            <a href="/blog" class="tlink">All posts</a>
          </p>
        </div>
      </footer>
    </article>
  </main>
  <SiteFooter />
</Layout>

<style>
  /* ---- Byline, inside the page head ------------------------------------- */
  .byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }

  .byline :global(.byline-avatar) {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .byline-name {
    font-family: var(--font-heading);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.012em;
  }

  .byline-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-brand-primary) 45%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.24em;
  }

  .byline-name a:hover {
    color: var(--color-brand-primary);
    text-decoration-color: currentColor;
  }

  .byline-meta {
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  /* ---- Featured image ---------------------------------------------------
     The one wide, loud moment on the page: full wrap width, cropped to a
     letterbox so the title and the opening paragraph still share the first
     screen. Credit sits on a hairline under it, not over it. */
  .hero {
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }

  .hero-frame {
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-brand);
  }

  .hero-frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* The letterbox keeps about two thirds of a 3:2 photo's height. Biased
     below centre because desk and still-life shots put their subject low
     in the frame, not in the sky above it. */
  @media (min-width: 44rem) {
    .hero-frame :global(img) {
      aspect-ratio: 21 / 9;
      object-position: 50% 70%;
    }
  }

  .hero figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-caption);
    color: var(--color-brand-muted);
  }

  /* ---- After the article ------------------------------------------------ */
  .post-foot {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .post-foot-col {
    display: grid;
    gap: 1.5rem;
    max-width: 44rem;
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  /* Chips are set in the heading face at small size, the one crossover the
     brand guide allows. They are topics, not links: there are no tag pages. */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 0.3rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: var(--fw-medium);
    line-height: 1.4;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: color-mix(in oklab, var(--color-brand-text) 80%, transparent);
  }

  .post-back {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
</style>
