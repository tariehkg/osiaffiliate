---
import '../styles/global.css';
import { SITE_NAME, absoluteUrl } from '../site';
import { organizationLd, websiteLd } from '../components/seo';

/**
 * The document shell every page uses.
 *
 * Everything a search engine reads about a page is set here from props, so a
 * page cannot ship without a canonical, a description or Open Graph tags:
 *
 *  - `title` and `description` become <title>, meta description and the OG /
 *    Twitter equivalents.
 *  - `path` (defaults to the current URL) becomes the canonical, always as an
 *    absolute URL on the production domain, without a trailing slash.
 *  - `jsonld` is any number of schema.org objects; Organization and WebSite
 *    are added on every page so the site is always identified.
 *  - `image` is the OG image path; defaults to the site card in /public.
 */
interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  /** "website" for hubs and lists, "article" for posts and product pages. */
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
}

const {
  title,
  description = '',
  path = Astro.url.pathname,
  image = '/og.png',
  type = 'website',
  noindex = false,
  jsonld = [],
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(image);
const blocks = [organizationLd(), websiteLd(), ...jsonld];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
